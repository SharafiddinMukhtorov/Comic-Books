@inherits LayoutComponentBase

<MudThemeProvider @ref="_tp" Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />

@Body

@code {
    MudThemeProvider _tp = null!;

    readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#60a5fa",
            Background = "#0f1117",
            Surface = "#1a1c28",
        }
    };
}
