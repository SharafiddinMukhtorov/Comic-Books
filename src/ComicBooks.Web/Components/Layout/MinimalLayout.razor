@inherits LayoutComponentBase
@inject ThemeService Theme

<MudThemeProvider @ref="_tp" Theme="@_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudSnackbarProvider />

@Body

@code {
    MudThemeProvider _tp = null!;
    bool _dark = true;

    readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#60a5fa",
            Background = "#0f1117",
            Surface = "#1a1c28",
        }
    };

    protected override void OnInitialized() => _dark = true;
}
