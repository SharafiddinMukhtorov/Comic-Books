@code {
    MudThemeProvider _tp = null!;
    bool _open;
    bool _searchOpen;
    string _q = "";
    List<ComicDto> _searchResults = new();
    List<ComicDto>? _allComics;   // bir marta yuklanadi, keyin xotirada filtrlanadi

    bool    _isLoggedIn;
    bool    _isAdmin;
    string  _userName    = "";
    string  _userPicture = "";
    int     _coinBalance;
    Guid    _userId      = Guid.Empty;

    readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary          = "#3b82f6",
            Secondary        = "#60a5fa",
            Background       = "#0f1117",
            Surface          = "#1a1c28",
            AppbarBackground = "#0f1117",
            AppbarText       = "#ffffff",
            DrawerBackground = "#131525",
            DrawerText       = "#e2e2f0",
            TextPrimary      = "#f0f0f8",
            TextSecondary    = "#8892a4",
            ActionDefault    = "#c8d0e0",
            LinesDefault     = "rgba(255,255,255,0.07)",
        }
    };

    protected override async Task OnInitializedAsync()
    {
        // TEZ render uchun: faqat claim'dan o'qiymiz, DB query yo'q
        var state = await AuthState.GetAuthenticationStateAsync();
        var user  = state.User;
        _isLoggedIn = user.Identity?.IsAuthenticated == true;

        if (_isLoggedIn)
        {
            _userName    = user.FindFirst("app_name")?.Value
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        ?? "Foydalanuvchi";
            _userPicture = user.FindFirst("app_picture")?.Value ?? "";
            _isAdmin     = user.FindFirst("app_is_admin")?.Value == "true";

            // Coin balance — claim'dan (tezda render)
            if (int.TryParse(user.FindFirst("app_coin_balance")?.Value, out var cb))
                _coinBalance = cb;

            if (Guid.TryParse(user.FindFirst("app_user_id")?.Value, out var uid))
                _userId = uid;
        }
    }

    // Circuit ulangandan keyin balansni DB dan yangilaymiz (block qilmaydi)
    bool _balanceRefreshed = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_isLoggedIn && _userId != Guid.Empty && !_balanceRefreshed)
            {
                _balanceRefreshed = true;
                try
                {
                    var freshBalance = await Mediator.Send(new GetCoinBalanceQuery(_userId));
                    if (freshBalance != _coinBalance)
                    {
                        _coinBalance = freshBalance;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch { /* ignore */ }
            }
        }
    }

    void Close() { _open = false; _q = ""; _searchResults = new(); }

    Task? _loadComicsTask;

    // Barcha komikslarni bir marta yuklaydi (≈100 ta — yengil). Bir nechta tez bosish
    // bir vaqtda chaqirsa ham faqat BITTA so'rov ketadi (DbContext to'qnashuvi bo'lmaydi).
    Task EnsureComicsLoaded() => _loadComicsTask ??= LoadComicsAsync();

    async Task LoadComicsAsync()
    {
        try
        {
            var res = await Mediator.Send(new GetComicsQuery(PageSize: 1000, SortBy: "views"));
            _allComics = res.Items;
        }
        catch { _allComics = new(); }
    }

    async Task OpenSearch()
    {
        _searchOpen = true;
        await EnsureComicsLoaded();
        FilterSearch();
        await InvokeAsync(StateHasChanged);
    }

    void CloseSearch()
    {
        _searchOpen = false;
        _q = "";
        _searchResults = new();
        // _allComics keshini saqlaymiz — keyingi ochilishda darrov ishlaydi
    }

    // Har bir harfda — DB'ga emas, xotiradagi ro'yxatga (desktop inline + mobil drawer uchun umumiy)
    async Task OnSearchInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        if (_allComics == null) await EnsureComicsLoaded();
        FilterSearch();
    }

    void OnDrawerSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var first = _searchResults.FirstOrDefault();
            if (first != null)
            {
                Nav.NavigateTo($"/comic/{first.Slug}");
                Close();
            }
        }
        else if (e.Key == "Escape") { _q = ""; _searchResults = new(); }
    }

    void FilterSearch()
    {
        var q = _q.Trim();
        if (q.Length < 2 || _allComics == null)
        {
            _searchResults = new();
            return;
        }
        _searchResults = _allComics
            .Where(c => (c.Title ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                     || (c.AlternativeTitles ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();
    }

    void OnSearchSheet(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var first = _searchResults.FirstOrDefault();
            if (first != null)
            {
                Nav.NavigateTo($"/comic/{first.Slug}");
                CloseSearch();
            }
        }
        else if (e.Key == "Escape") CloseSearch();
    }

}
