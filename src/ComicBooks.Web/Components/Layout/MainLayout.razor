@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IMediator Mediator

<style>
    /* ═══ Responsive utility classes (faster than MudHidden — CSS-only) ═══ */
    /* Desktop-only (hidden on mobile) */
    .nav-desk        { display: inline-flex !important; align-items: center; }
    .nav-desk-search { display: flex !important; }
    /* Mobile-only (hidden on desktop) */
    .nav-mob         { display: none !important; }

    @@media (max-width: 960px) {
        .nav-desk        { display: none !important; }
        .nav-desk-search { display: none !important; }
        .nav-mob         { display: inline-flex !important; align-items: center; }
    }

    /* Navbar tugmalari (CSS-only, mud emas — instant render) */
    .nav-link-btn {
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        border-radius: 8px;
        white-space: nowrap;
        transition: background 0.15s;
    }
    .nav-link-btn:hover { background: rgba(255,255,255,0.12); color: #fff; }

    .nav-icon-btn {
        background: #1E1E2E;
        border: none;
        color: #fff;
        cursor: pointer;
        width: 38px; height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        margin-left: 6px;
        transition: background 0.15s;
    }
    .nav-icon-btn:hover { background: rgba(255,255,255,0.18); }

    .nav-coin-btn {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        border: 1px solid rgba(245,158,11,0.6);
        color: #f59e0b;
        background: rgba(245,158,11,0.1);
        text-decoration: none;
        margin-left: 6px;
        white-space: nowrap;
    }
    .nav-coin-btn:hover { background: rgba(245,158,11,0.2); color: #f59e0b; }

    /* Centered nav links — absolute center in AppBar */
    .nav-center-links {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .nav-kirish-btn {
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        border: none;
        color: #fff;
        background: linear-gradient(90deg, #1C72F3 0%, #1392EC 100%);
        text-decoration: none;
        margin-left: 6px;
        white-space: nowrap;
        transition: filter 0.15s;
    }
    .nav-kirish-btn:hover { filter: brightness(1.1); color: #fff; }

    /* Search bar — Asura Scans uslubida */
    .srch-bar-inline {
        background: var(--mud-palette-surface);
        border-bottom: 1px solid rgba(255,255,255,0.07);
        padding: 12px 20px;
        position: relative;
        z-index: 10;
    }
    @@keyframes srch-drop {
        from { opacity:0; }
        to   { opacity:1; }
    }
    /* Input wrapper — ko'k border bilan */
    .srch-input-wrap {
        position: relative;
        background: rgba(28,114,243,0.06);
        border: 1.5px solid rgba(28,114,243,0.55);
        border-radius: 10px;
        box-shadow: 0 0 0 3px rgba(28,114,243,0.08);
    }
    .srch-input-wrap:focus-within {
        border-color: #1C72F3;
        background: rgba(28,114,243,0.09);
        box-shadow: 0 0 0 4px rgba(28,114,243,0.15);
    }
    .srch-sheet-input {
        width: 100%;
        padding: 12px 44px 12px 44px;
        border: none;
        border-radius: 8px;
        background: transparent;
        outline: none;
        font-size: 15px;
        font-family: inherit;
        color: var(--mud-palette-text-primary);
    }
    .srch-sheet-input::placeholder { color: var(--mud-palette-text-secondary); opacity: 0.6; }
    .srch-sheet-icon {
        position: absolute;
        left: 14px; top: 50%;
        transform: translateY(-50%);
        color: rgba(255,255,255,0.4);
        pointer-events: none;
    }
    .srch-bar-close {
        position: absolute;
        right: 10px; top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: rgba(255,255,255,0.3);
        display: flex; align-items: center;
        padding: 4px;
        border-radius: 6px;
        transition: color 0.15s;
    }
    .srch-bar-close:hover { color: rgba(255,255,255,0.7); }
    /* Backdrop */
    .srch-bar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.2);
        z-index: 9;
    }

    /* ── Jonli qidiruv natijalari (dropdown) ── */
    .srch-results {
        margin-top: 10px;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 12px;
        overflow: hidden;
        max-height: 60vh;
        overflow-y: auto;
        box-shadow: 0 14px 36px rgba(0,0,0,0.30);
    }
    .srch-res {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        text-decoration: none;
        color: var(--mud-palette-text-primary);
        border-bottom: 1px solid var(--mud-palette-lines-default);
        transition: background 0.15s;
    }
    .srch-res:last-child { border-bottom: none; }
    .srch-res:hover { background: rgba(59,130,246,0.10); }
    .srch-res-img {
        width: 44px; height: 60px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
        background: #1a1c28;
    }
    .srch-res-info { min-width: 0; flex: 1; }
    .srch-res-title {
        font-size: 14px; font-weight: 700;
        color: var(--mud-palette-text-primary);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .srch-res-meta {
        font-size: 12px;
        color: var(--mud-palette-text-secondary);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        margin-top: 2px;
    }
    .srch-msg {
        padding: 18px 14px;
        text-align: center;
        color: var(--mud-palette-text-secondary);
        font-size: 13px;
    }

    .nav-kirish-mob {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        height: 40px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        border: none;
        color: #fff;
        background: linear-gradient(90deg, #1C72F3 0%, #1392EC 100%);
        text-decoration: none;
        margin-left: 6px;
        white-space: nowrap;
        flex-shrink: 0;
        transition: filter 0.15s;
    }
    .nav-kirish-mob:hover { filter: brightness(1.1); color: #fff; }

    .nav-avatar-btn {
        width: 40px; height: 40px;
        background: #3b82f6;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 6px;
        overflow: hidden;
    }

    /* Mobile icon buttons: always show rounded-square bg */
    @@media (max-width: 960px) {
        .nav-icon-btn {
            background: rgba(255,255,255,0.10) !important;
            border-radius: 10px !important;
            width: 40px !important;
            height: 40px !important;
            margin-left: 6px !important;
        }
    }

    /* ═══ Top-down mobile drawer ═══ */
    .mdunyo-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1200;
        animation: md-backdrop-in 0.18s ease;
    }
    @@keyframes md-backdrop-in { from { opacity: 0; } to { opacity: 1; } }

    .mdunyo-drawer {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1300;
        background: var(--mud-palette-surface);
        border-bottom: 1px solid rgba(128,128,128,0.18);
        border-radius: 0 0 12px 12px;
        max-height: 92vh;
        overflow-y: auto;
        box-shadow: 0 12px 32px rgba(0,0,0,0.35);
        animation: md-slide-down 0.22s cubic-bezier(0.32,0.72,0.45,1);
        --mdunyo-acc: #3b82f6;
        --mdunyo-acc2: #60a5fa;
    }
    @@keyframes md-slide-down {
        from { transform: translateY(-100%); }
        to   { transform: translateY(0); }
    }

    .mdunyo-drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px 10px;
        border-bottom: 1px solid rgba(128,128,128,0.12);
    }

    .mdunyo-head-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid rgba(128,128,128,0.2);
        background: transparent;
        color: inherit;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }
    .mdunyo-head-btn:hover { background: rgba(59,130,246,0.1); }
    .mdunyo-head-btn.close {
        background: rgba(128,128,128,0.15);
        color: inherit;
        border-color: rgba(128,128,128,0.2);
    }
    .mdunyo-head-btn.close:hover { background: rgba(128,128,128,0.25); }

    .mdunyo-user-card {
        margin: 0 16px 12px;
        padding: 12px 14px;
        background: linear-gradient(135deg, rgba(96,165,250,0.15), rgba(59,130,246,0.08));
        border: 1px solid rgba(96,165,250,0.25);
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .mdunyo-nav {
        padding: 4px 12px 18px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mdunyo-nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        font-size: 14px;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        text-decoration: none;
        border-radius: 8px;
        transition: background 0.15s;
    }
    .mdunyo-nav-item:hover { background: rgba(96,165,250,0.10); }
    .mdunyo-nav-item.active {
        background: linear-gradient(90deg, rgba(96,165,250,0.22), rgba(96,165,250,0.04));
        color: #60a5fa;
        font-weight: 800;
    }
    .mdunyo-nav-item.danger { color: #ef4444; }
    .mdunyo-nav-item.danger:hover { background: rgba(239,68,68,0.1); }
    .mdunyo-nav-item.highlight {
        background: linear-gradient(135deg, #3b82f6, #60a5fa);
        color: #fff;
        font-weight: 800;
        justify-content: center;
        margin-top: 4px;
    }
    .mdunyo-nav-item.highlight:hover { filter: brightness(1.1); background: linear-gradient(135deg, #3b82f6, #60a5fa); }

    /* ═══ FOOTER ═══ */
    .sf {
        background: #050811;
        border-top: 1px solid rgba(255,255,255,0.06);
        margin-top: 30px;
    }
    .sf-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 52px 32px 36px;
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr 1fr;
        gap: 48px;
    }

    /* Brand column */
    .sf-logo-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        margin-bottom: 14px;
    }
    .sf-logo-text {
        font-weight: 900;
        font-size: 1.1rem;
        color: #fff;
        letter-spacing: -0.3px;
    }
    .sf-tagline {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        line-height: 1.65;
        margin: 0 0 20px;
        max-width: 280px;
    }
    .sf-socials {
        display: flex;
        gap: 10px;
    }
    .sf-soc {
        width: 38px; height: 38px;
        border-radius: 10px;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
    }
    .sf-soc:hover { background: #3b82f6; color: #fff; border-color: #3b82f6; }

    /* Nav columns */
    .sf-col { display: flex; flex-direction: column; gap: 12px; }
    .sf-col-title {
        font-size: 11px;
        font-weight: 800;
        color: #3b82f6;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 6px;
    }
    .sf-link {
        font-size: 13px;
        color: rgba(255,255,255,0.45);
        text-decoration: none;
        transition: color 0.15s;
    }
    .sf-link:hover { color: #60a5fa; }
    .sf-contact {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    /* Bottom bar */
    .sf-bottom {
        max-width: 1200px;
        margin: 0 auto;
        padding: 18px 32px;
        border-top: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: rgba(255,255,255,0.28);
        flex-wrap: wrap;
        gap: 8px;
    }
    .sf-bottom-links { display: flex; gap: 16px; }
    .sf-bottom-link {
        color: rgba(255,255,255,0.28);
        text-decoration: none;
        transition: color 0.15s;
    }
    .sf-bottom-link:hover { color: rgba(255,255,255,0.6); }

    /* Responsive */
    @@media (max-width: 900px) {
        .sf { margin-top: 24px; }   /* mobil: kontent bilan oraliq kamaytirildi */
        .sf-inner {
            grid-template-columns: 1fr 1fr;
            gap: 28px 20px;
            padding: 36px 20px 24px;
        }
        /* Brand: full width top */
        .sf-brand { grid-column: 1 / -1; }
        .sf-tagline { max-width: 100%; }
        /* Aloqa: full width bottom */
        .sf-col:last-child { grid-column: 1 / -1; }
        .sf-bottom { padding: 14px 20px; }
    }
    @@media (max-width: 480px) {
        .sf-inner { padding: 28px 16px 20px; gap: 24px 16px; }
        .sf-bottom { padding: 12px 16px; flex-direction: column; align-items: flex-start; }
    }
</style>

<MudThemeProvider @ref="_tp" Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true"
               Style="background:#0f1117 !important;border-bottom:none !important;box-shadow:none !important;">
        <div style="display:flex;align-items:center;width:100%;max-width:1150px;margin:0 auto;position:relative;">

        <!-- Logo -->
        <a href="/" style="display:flex;align-items:center;gap:6px;text-decoration:none;flex-shrink:0;">
            <img src="/img/logo.png"
                 width="46" height="46" alt="Manga Dunyo" style="border-radius:12px;" />
            <img src="/img/logo-wordmark.png" alt="MANGA DUNYO"
                 style="height:44px;width:auto;display:block;" />
        </a>

        <!-- Nav links — absolutely centered in AppBar -->
        <div class="nav-desk nav-center-links">
            <a href="/" class="nav-link-btn">Bosh sahifa</a>
            <a href="/bookmarks" class="nav-link-btn">Saqlanganlar</a>
            <a href="/comics" class="nav-link-btn">Katalog</a>
            <a href="/videos" class="nav-link-btn">Videolar</a>
        </div>

        <MudSpacer />

        <!-- Search icon button — desktop va mobile (birinchi o'rinda o'ngda) -->
        <button @onclick="@OpenSearch" class="nav-icon-btn" title="Qidirish">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
        </button>

        @if (_isLoggedIn)
        {
            <!-- Coin balance (desktop) -->
            <a href="/coins" class="nav-desk nav-coin-btn">
                <img src="/img/coin.png" style="width:18px;height:18px;vertical-align:middle;margin-right:5px;" alt="coin" />
                @_coinBalance
            </a>

            <!-- User avatar menu (desktop) -->
            <div class="nav-desk" style="margin-left:8px;">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <div style="display:flex;align-items:center;gap:8px;cursor:pointer;
                                    background:rgba(255,255,255,0.1);border-radius:10px;
                                    padding:5px 10px 5px 6px;border:1px solid rgba(255,255,255,0.2);">
                            @if (!string.IsNullOrEmpty(_userPicture))
                            {
                                <img src="@_userPicture" width="30" height="30"
                                     style="border-radius:50%;object-fit:cover;" alt="@_userName" />
                            }
                            else
                            {
                                <MudAvatar Size="Size.Small" Style="width:30px;height:30px;background:#60a5fa;">
                                    @(_userName.Length > 0 ? _userName[0].ToString().ToUpper() : "U")
                                </MudAvatar>
                            }
                            <span style="color:#fff;font-weight:600;font-size:13px;max-width:100px;
                                         overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @_userName
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Style="color:rgba(255,255,255,0.7);font-size:18px;" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        @if (_isAdmin)
                        {
                            <MudMenuItem Href="/admin" Icon="@Icons.Material.Filled.AdminPanelSettings">
                                Admin panel
                            </MudMenuItem>
                            <MudDivider />
                        }
                        <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">
                            Profil
                        </MudMenuItem>
                        <MudMenuItem Href="/coins" Icon="@Icons.Material.Filled.Toll">
                            Tangalar: @_coinBalance
                        </MudMenuItem>
                        @* Daromad endi admin panel ichida *@
                        <MudMenuItem Href="/bookmarks" Icon="@Icons.Material.Filled.Bookmark">
                            Saqlanganlar
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Href="/auth/logout" Icon="@Icons.Material.Filled.Logout"
                                     Style="color:#ef4444;">
                            Chiqish
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>

            <!-- Mobile: avatar only -->
            <button class="nav-mob nav-avatar-btn" @onclick="@(() => _open = !_open)">
                @if (!string.IsNullOrEmpty(_userPicture))
                {
                    <img src="@_userPicture" width="40" height="40"
                         style="border-radius:10px;object-fit:cover;width:100%;height:100%;" alt="@_userName" />
                }
                else
                {
                    <span style="color:#fff;font-weight:800;font-size:15px;">
                        @(_userName.Length > 0 ? _userName[0].ToString().ToUpper() : "U")
                    </span>
                }
            </button>
        }
        else
        {
            <!-- Coin button (desktop, not logged in) -->
            <a href="/coins" class="nav-desk nav-coin-btn" style="text-decoration:none;">
                <img src="/img/coin.png" style="width:18px;height:18px;vertical-align:middle;margin-right:5px;" alt="coin" />Tanga
            </a>

            <!-- Kirish button (desktop) -->
            <a href="/login" class="nav-desk nav-kirish-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                Kirish
            </a>

            <!-- Mobile: Kirish button -->
            <a href="/login" class="nav-mob nav-kirish-mob">Kirish</a>
        }

        <!-- Hamburger menu (mobile only) -->
        <button class="nav-mob nav-icon-btn" @onclick="@(() => _open = !_open)" title="Menyu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        </div>
    </MudAppBar>

    <!-- ═══ Top-down Mobile Drawer ═══ -->
    @if (_open)
    {
        <!-- Backdrop -->
        <div class="mdunyo-backdrop" @onclick="@Close"></div>

        <div class="mdunyo-drawer" style="background:#17181e;">
            <!-- Header inside drawer -->
            <div class="mdunyo-drawer-head">
                <a href="/" @onclick="@Close" style="display:flex;align-items:center;gap:6px;text-decoration:none;">
                    <img src="/img/logo.png" width="34" height="34" style="border-radius:8px;" />
                    <img src="/img/logo-wordmark.png" alt="MANGA DUNYO" style="height:30px;width:auto;display:block;" />
                </a>
                <div style="display:flex;align-items:center;gap:6px;">
                    <button class="mdunyo-head-btn close" @onclick="@Close" title="Yopish">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            </div>

            <!-- Search bar (jonli — desktopdek) -->
            <div style="padding:8px 16px 14px;">
                <div style="position:relative;">
                    <MudIcon Icon="@Icons.Material.Filled.Search"
                             Style="position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:18px;opacity:0.5;" />
                    <input @oninput="@OnSearchInput" @onkeydown="@OnDrawerSearchKey"
                           placeholder="O'z dunyongizni qidiring..." autocomplete="off"
                           style="width:100%;padding:11px 14px 11px 38px;border-radius:10px;
                                  border:1px solid rgba(128,128,128,0.25);
                                  background:rgba(128,128,128,0.07);outline:none;font-size:14px;
                                  color:var(--mud-palette-text-primary);" />
                </div>

                @* Jonli natijalar — har bir harfda yangilanadi *@
                @if (_q.Trim().Length >= 2)
                {
                    <div class="srch-results" style="margin-top:10px;box-shadow:none;">
                        @if (_allComics == null)
                        {
                            <div class="srch-msg">Yuklanmoqda…</div>
                        }
                        else if (_searchResults.Count == 0)
                        {
                            <div class="srch-msg">Hech narsa topilmadi</div>
                        }
                        else
                        {
                            @foreach (var c in _searchResults)
                            {
                                <a class="srch-res" href="/comic/@c.Slug" @onclick="@Close">
                                    <img class="srch-res-img"
                                         src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/60/80")"
                                         onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)s/60/80'" />
                                    <div class="srch-res-info">
                                        <div class="srch-res-title">@c.Title</div>
                                        <div class="srch-res-meta">@string.Join(", ", TranslateMany(c.Genres.Take(5)))@(c.ReleaseYear.HasValue ? $" • {c.ReleaseYear}" : "")</div>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                }
            </div>

            @* Qidiruv paytida (2+ harf) menyu yashiriladi — faqat natijalar ko'rinadi *@
            @if (_q.Trim().Length < 2)
            {
            @if (_isLoggedIn)
            {
                <!-- User card -->
                <div class="mdunyo-user-card">
                    @if (!string.IsNullOrEmpty(_userPicture))
                    {
                        <img src="@_userPicture" width="42" height="42"
                             style="border-radius:50%;object-fit:cover;" alt="@_userName" />
                    }
                    else
                    {
                        <MudAvatar Style="background:#60a5fa;width:42px;height:42px;">
                            @(_userName.Length > 0 ? _userName[0].ToString().ToUpper() : "U")
                        </MudAvatar>
                    }
                    <div>
                        <div style="font-weight:800;font-size:14px;">@_userName</div>
                        <div style="font-size:12px;color:var(--mud-palette-text-secondary);">
                            <img src="/img/coin.png" style="width:14px;height:14px;vertical-align:middle;margin-right:3px;" />
                            @_coinBalance tanga
                        </div>
                    </div>
                </div>
            }

            <!-- Nav items -->
            <div class="mdunyo-nav">
                @{ var path = new Uri(Nav.Uri).AbsolutePath; }
                <a href="/"          @onclick="@Close" class="mdunyo-nav-item @(path == "/" ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" /> Bosh sahifa
                </a>
                <a href="/comics"    @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/comics") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" /> Katalog
                </a>
                <a href="/videos"    @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/videos") || path.StartsWith("/video/") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" /> Videolar
                </a>
                <a href="/bookmarks" @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/bookmarks") ? "active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" /> Sevimlilar
                </a>
                @if (_isLoggedIn)
                {
                    <a href="/profile" @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/profile") ? "active" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> Profil
                    </a>
                    <a href="/coins" @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/coins") ? "active" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.Toll" Size="Size.Small" /> Tangalar: @_coinBalance
                    </a>
                    @* Daromad endi admin panel ichida — bu yerda yo'q *@
                }
                @if (_isAdmin)
                {
                    <a href="/admin" @onclick="@Close" class="mdunyo-nav-item @(path.StartsWith("/admin") ? "active" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" /> Admin panel
                    </a>
                }

                <div style="height:1px;background:rgba(128,128,128,0.15);margin:6px 16px;"></div>

                @if (_isLoggedIn)
                {
                    <a href="/auth/logout" @onclick="@Close" class="mdunyo-nav-item danger">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" /> Chiqish
                    </a>
                }
                else
                {
                    <a href="/login" @onclick="@Close" class="mdunyo-nav-item">
                        <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Small" /> Kirish
                    </a>
                    <a href="/login" @onclick="@Close" class="mdunyo-nav-item highlight">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" /> Ro'yxatdan o'tish
                    </a>
                }
            </div>
            }
        </div>
    }

    <MudMainContent Style="min-height:100vh;margin:0;background:var(--mud-palette-background);">

        @* ── Search bar: navbar va carousel orasida, normal flow ── *@
        @if (_searchOpen)
        {
            <div class="srch-bar-inline">
                <div class="srch-input-wrap">
                    <span class="srch-sheet-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                    </span>
                    <input class="srch-sheet-input"
                           @oninput="@OnSearchInput"
                           @onkeydown="@OnSearchSheet"
                           placeholder="O'z dunyongizni qidiring..."
                           autocomplete="off" />
                    <button class="srch-bar-close" @onclick="@CloseSearch" title="Yopish">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                @* ── Jonli qidiruv natijalari (har bir harfda yangilanadi) ── *@
                @if (_q.Trim().Length >= 2)
                {
                    <div class="srch-results">
                        @if (_allComics == null)
                        {
                            <div class="srch-msg">Yuklanmoqda…</div>
                        }
                        else if (_searchResults.Count == 0)
                        {
                            <div class="srch-msg">Hech narsa topilmadi</div>
                        }
                        else
                        {
                            @foreach (var c in _searchResults)
                            {
                                <a class="srch-res" href="/comic/@c.Slug" @onclick="@CloseSearch">
                                    <img class="srch-res-img"
                                         src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/60/80")"
                                         onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)s/60/80'" />
                                    <div class="srch-res-info">
                                        <div class="srch-res-title">@c.Title</div>
                                        <div class="srch-res-meta">@string.Join(", ", TranslateMany(c.Genres.Take(5)))@(c.ReleaseYear.HasValue ? $" • {c.ReleaseYear}" : "")</div>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                }
            </div>
            <div class="srch-bar-backdrop" @onclick="@CloseSearch"></div>
        }

        @Body

        <!-- ════ SITE FOOTER ════ -->
