<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f1117" id="theme-color-meta" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <base href="/" />

    <!-- Critical inline CSS — flash of unstyled content (FOUC) oldini oladi -->
    <style>
        html, body { margin: 0 !important; padding: 0 !important; background: #0f1117; min-height: 100vh; }
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
        .mud-appbar.mud-appbar-fixed, header.mud-appbar { top: 0 !important; margin: 0 !important; }
        .mud-layout { margin: 0 !important; }
        /* Navbar — sahifa bilan birga ko'tariladi (qog'ozga yopishtirilgandek) */
        header.mud-appbar {
            position: relative !important;
            top: auto !important;
            transform: none !important;
            transition: none !important;
        }

        /* ── Blazor reconnect — xunuk oq modal o'rniga pastda kichik banner ── */
        #components-reconnect-modal {
            display: none;
            position: fixed;
            left: 50%; bottom: 18px;
            transform: translateX(-50%);
            z-index: 100000;
            align-items: center;
            gap: 9px;
            background: #1a1c28;
            color: #fff;
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px;
            padding: 9px 15px;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 28px rgba(0,0,0,0.5);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            max-width: calc(100vw - 24px);
        }
        #components-reconnect-modal.components-reconnect-show,
        #components-reconnect-modal.components-reconnect-failed,
        #components-reconnect-modal.components-reconnect-rejected {
            display: flex;
        }
        #components-reconnect-modal .rc-text-rejected,
        #components-reconnect-modal .rc-reload { display: none; }
        #components-reconnect-modal.components-reconnect-rejected .rc-spinner,
        #components-reconnect-modal.components-reconnect-rejected .rc-text-retry { display: none; }
        #components-reconnect-modal.components-reconnect-rejected .rc-text-rejected,
        #components-reconnect-modal.components-reconnect-rejected .rc-reload { display: inline-flex; }
        .rc-spinner {
            width: 16px; height: 16px; flex-shrink: 0;
            border: 2px solid rgba(255,255,255,0.25);
            border-top-color: #3b82f6;
            border-radius: 50%;
            animation: rc-spin 0.8s linear infinite;
        }
        @@keyframes rc-spin { to { transform: rotate(360deg); } }
        .rc-reload {
            background: #3b82f6; color: #fff; border: none;
            padding: 5px 12px; border-radius: 7px;
            font-size: 12px; font-weight: 700; cursor: pointer;
            align-items: center;
        }

        /* Muvaffaqiyat bildirishnomasi (snackbar) — yashil o'rniga ko'k brend rangi */
        .mud-snackbar.mud-alert-filled-success {
            background-color: #3b82f6 !important;
        }
    </style>
    <!-- Theme flash oldini olish: localStorage dan darhol o'qiymiz -->
    <script>
        (function(){
            try {
                var t = localStorage.getItem('md-theme');
                if (t === 'light') {
                    document.documentElement.style.background = '#F8FAFF';
                    document.body && (document.body.style.background = '#F8FAFF');
                }
            } catch(e){}
        })();
        // Element'ni ko'rinishga olib kelish (pagination bosilganda joyida turishi uchun)
        window.scrollToEl = function(id){
            try { var e = document.getElementById(id); if (e) e.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch(e){}
        };
    </script>

    <!-- Favicon (browser tab icon) -->
    <link rel="icon" type="image/svg+xml" href="/img/logo.png" />
    <link rel="apple-touch-icon" href="/img/logo.png" />
    <link rel="shortcut icon" href="/img/logo.png" />

    <!-- Performance: preconnect to Google Fonts (parallel DNS+TLS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    <Routes @rendermode="@InteractiveServer" />

    <!-- Blazor reconnect banner (standart oq modal o'rniga) -->
    <div id="components-reconnect-modal">
        <span class="rc-spinner"></span>
        <span class="rc-text-retry">Serverga qayta ulanmoqda…</span>
        <span class="rc-text-rejected">Aloqa uzildi.</span>
        <button class="rc-reload" onclick="location.reload()">Yangilash</button>
    </div>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/pdf-processor.js"></script>
    <script src="js/lazyReader.js"></script>
    <script src="js/themeColor.js"></script>
    <script src="js/protect.js"></script>
</body>
</html>
