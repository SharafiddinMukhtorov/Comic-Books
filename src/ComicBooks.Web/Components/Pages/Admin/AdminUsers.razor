@page "/admin/users"
@layout AdminLayout
@inject IMediator Mediator
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@using ComicBooks.Application.Features.Admin.Queries
@using System.Globalization

<PageTitle>Foydalanuvchilar - Admin</PageTitle>

<style>
    .users-wrap { max-width: 1280px; }
    .users-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .users-title {
        font-size: 1.5rem;
        font-weight: 900;
        margin: 0;
        background: linear-gradient(135deg, #fff, #60a5fa);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .filter-bar {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 18px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter-input {
        flex: 1;
        min-width: 220px;
        background: rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 9px;
        padding: 10px 14px;
        color: #fff;
        font-size: 14px;
        outline: none;
    }
    .filter-input:focus { border-color: #5b9fd9; }

    .filter-chip {
        padding: 8px 14px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.04);
        color: rgba(255,255,255,0.7);
        transition: all 0.15s;
    }
    .filter-chip:hover { background: rgba(255,255,255,0.08); }
    .filter-chip.active {
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: #fff;
        border-color: transparent;
    }

    .glass-card {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 20px;
        overflow-x: auto;
    }

    .users-tbl { width: 100%; border-collapse: collapse; }
    .users-tbl th {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        opacity: 0.55;
        text-align: left;
        padding: 12px;
        letter-spacing: 0.5px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .users-tbl td {
        font-size: 13px;
        padding: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .users-tbl tr:hover td { background: rgba(91,159,217,0.05); }

    .u-ava {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: #fff;
        font-weight: 800;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-right: 10px;
        vertical-align: middle;
    }
    .u-ava img { width: 100%; height: 100%; object-fit: cover; }

    .b-auth {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
        display: inline-block;
        margin-right: 4px;
    }
    .b-google   { background: rgba(34,197,94,0.18); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
    .b-password { background: rgba(91,159,217,0.18); color: #5b9fd9; border: 1px solid rgba(91,159,217,0.3); }
    .b-admin    { background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); }

    .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 20px; }
    .pg-btn {
        min-width: 36px;
        height: 36px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.85);
        font-weight: 700;
        font-size: 13px;
        border-radius: 9px;
        cursor: pointer;
        padding: 0 10px;
    }
    .pg-btn:hover:not(:disabled) { background: rgba(91,159,217,0.15); border-color: rgba(91,159,217,0.4); }
    .pg-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .pg-btn.active { background: linear-gradient(135deg, #60a5fa, #3b82f6); color: #fff; border-color: transparent; }
</style>

@if (_checking)
{
    <div style="padding:80px;text-align:center;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (!_isSuper)
{
    <div style="padding:60px;text-align:center;">
        <div style="font-size:3rem;margin-bottom:14px;">🔒</div>
        <h3>Faqat super admin uchun</h3>
    </div>
}
else
{
<div class="users-wrap">
    <div class="users-head">
        <h1 class="users-title">👥 Foydalanuvchilar</h1>
        <span style="opacity:0.55;font-size:13px;">Jami: <b style="color:#fff;">@_users.Count</b></span>
    </div>

    <!-- Filterlar -->
    <div class="filter-bar">
        <input type="text" class="filter-input" placeholder="🔍 Ism yoki email bo'yicha qidirish..."
               value="@_search" @oninput="@(e => { _search = e.Value?.ToString() ?? ""; _page = 1; })" />

        <button class="filter-chip @(_filter == "all" ? "active" : "")" @onclick="@(() => { _filter = "all"; _page = 1; })">
            Hammasi
        </button>
        <button class="filter-chip @(_filter == "google" ? "active" : "")" @onclick="@(() => { _filter = "google"; _page = 1; })">
            G Google
        </button>
        <button class="filter-chip @(_filter == "password" ? "active" : "")" @onclick="@(() => { _filter = "password"; _page = 1; })">
            🔒 Parol
        </button>
        <button class="filter-chip @(_filter == "admin" ? "active" : "")" @onclick="@(() => { _filter = "admin"; _page = 1; })">
            👑 Admin
        </button>
        <button class="filter-chip @(_filter == "coin" ? "active" : "")" @onclick="@(() => { _filter = "coin"; _page = 1; })">
            🪙 Coinli
        </button>
    </div>

    @if (Filtered().Count == 0)
    {
        <div class="glass-card" style="text-align:center;padding:40px;opacity:0.5;">
            🔍 Hech qanday foydalanuvchi topilmadi
        </div>
    }
    else
    {
        <div class="glass-card">
            <table class="users-tbl">
                <thead>
                    <tr>
                        <th>Foydalanuvchi</th>
                        <th>Email</th>
                        <th>Kirish</th>
                        <th style="text-align:right;">Coin</th>
                        <th>Ro'yxatdan o'tgan</th>
                        <th>So'nggi kirish</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in PagedUsers())
                    {
                        <tr>
                            <td>
                                <div class="u-ava">
                                    @if (!string.IsNullOrEmpty(u.Picture))
                                    {
                                        <img src="@u.Picture" alt="@u.Name" />
                                    }
                                    else
                                    {
                                        @(u.Name.Length > 0 ? u.Name[0].ToString().ToUpper() : "?")
                                    }
                                </div>
                                <span style="vertical-align:middle;font-weight:700;">@u.Name</span>
                                @if (u.IsAdmin)
                                {
                                    <span class="b-auth b-admin" style="margin-left:6px;">ADMIN</span>
                                }
                            </td>
                            <td style="opacity:0.78;">@u.Email</td>
                            <td>
                                @if (u.HasGoogle) { <span class="b-auth b-google">G Google</span> }
                                @if (u.HasPassword) { <span class="b-auth b-password">🔒 Parol</span> }
                            </td>
                            <td style="text-align:right;font-weight:800;color:#fbbf24;">@u.CoinBalance</td>
                            <td style="opacity:0.7;font-size:12px;">@FmtDate(u.CreatedAt)</td>
                            <td style="opacity:0.6;font-size:12px;">@FmtRelative(u.LastLogin)</td>
                        </tr>
                    }
                </tbody>
            </table>

            @{ var totalPages = (int)Math.Ceiling(Filtered().Count / (double)_pageSize); }
            @if (totalPages > 1)
            {
                <div class="pager">
                    <button class="pg-btn" disabled="@(_page <= 1)" @onclick="@(() => _page--)">‹</button>
                    @for (int p = Math.Max(1, _page - 2); p <= Math.Min(totalPages, _page + 2); p++)
                    {
                        int pg = p;
                        <button class="pg-btn @(pg == _page ? "active" : "")" @onclick="@(() => _page = pg)">@pg</button>
                    }
                    <button class="pg-btn" disabled="@(_page >= totalPages)" @onclick="@(() => _page++)">›</button>
                    <span style="margin-left:14px;opacity:0.55;font-size:12px;">@_page / @totalPages</span>
                </div>
            }
        </div>
    }
</div>
}

@code {
    List<AdminUserDto> _users = new();
    bool   _checking = true;
    bool   _isSuper  = false;
    string _search   = "";
    string _filter   = "all";
    int    _page     = 1;
    const int _pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        var role = st.User.FindFirst("admin_role")?.Value;
        _isSuper = role == "super";

        if (_isSuper)
        {
            try { _users = await Mediator.Send(new GetUsersListQuery(500)); }
            catch { _users = new(); }
        }
        _checking = false;
    }

    List<AdminUserDto> Filtered()
    {
        IEnumerable<AdminUserDto> q = _users;

        // Filter chips
        q = _filter switch
        {
            "google"   => q.Where(u => u.HasGoogle),
            "password" => q.Where(u => u.HasPassword),
            "admin"    => q.Where(u => u.IsAdmin),
            "coin"     => q.Where(u => u.CoinBalance > 0),
            _          => q
        };

        // Search
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(u =>
                u.Name.ToLowerInvariant().Contains(s) ||
                u.Email.ToLowerInvariant().Contains(s));
        }
        return q.ToList();
    }

    List<AdminUserDto> PagedUsers() =>
        Filtered().Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();

    static string FmtDate(DateTime d) =>
        d.ToString("d MMM yyyy, HH:mm", CultureInfo.InvariantCulture);

    static string FmtRelative(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalMinutes < 1)  return "hozir";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays} kun oldin";
        return d.ToString("d MMM", CultureInfo.InvariantCulture);
    }
}
