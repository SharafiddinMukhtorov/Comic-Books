        }
    }

    async Task<string> SaveUploadedFileAsync(IBrowserFile file, string ext, string kind, long maxSizeBytes = 30 * 1024 * 1024)
    {
        var uploadsPath = Config["Uploads:Path"];
        if (string.IsNullOrWhiteSpace(uploadsPath))
        {
            uploadsPath = Env.IsDevelopment()
                ? Path.Combine(Env.ContentRootPath, "wwwroot", "uploads")
                : "/var/www/comicbooks/uploads";
        }

        var sub = kind switch
        {
            "videoposter" => "videoposters",
            "videobanner" => "videobanners",
            "cast"        => "cast",
            "video"       => "videos",
            _             => "videoposters"
        };
        var dir = Path.Combine(uploadsPath, sub);
        Directory.CreateDirectory(dir);

        var name = $"{DateTime.UtcNow:yyyyMMddHHmmss}_{Guid.NewGuid():N}{ext}";
        var fullPath = Path.Combine(dir, name);

        using var stream = file.OpenReadStream(maxAllowedSize: maxSizeBytes);
        await using (var fs = new FileStream(fullPath, FileMode.Create))
        {
            await stream.CopyToAsync(fs);
        }

        return $"/uploads/{sub}/{name}";
    }

    async Task UploadVideoFileAsync(InputFileChangeEventArgs e, Action<string> setUrl, Action onStart, Action onEnd)
    {
        var file = e.File;
        if (file is null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".mp4", ".webm", ".mov", ".mkv", ".avi" };
        if (!allowed.Contains(ext))
        {
            Snackbar.Add("❌ Faqat mp4/webm/mov/mkv/avi", Severity.Error);
            return;
        }

        onStart();
        StateHasChanged();

        try
        {
            var url = await SaveUploadedFileAsync(file, ext, "video", maxSizeBytes: 2L * 1024 * 1024 * 1024);
            setUrl(url);
            Snackbar.Add("✅ Video yuklandi", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Xato: {ex.Message}", Severity.Error);
        }
        finally
        {
            onEnd();
            StateHasChanged();
        }
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_title)) { Snackbar.Add("Nomni kiriting!", Severity.Warning); return; }
        if (_type == VideoType.Movie && string.IsNullOrWhiteSpace(_videoUrl)) { Snackbar.Add("Film uchun video havolasini kiriting!", Severity.Warning); return; }
        if (_type == VideoType.Series && _episodes.Count == 0) { Snackbar.Add("Serial uchun kamida bitta qism qo'shing!", Severity.Warning); return; }

        _saving = true;
        try
        {
            var episodeDtos = _episodes.Select(e => new VideoEpisodeItemDto(
                e.SeasonNumber, e.EpisodeNumber, e.Title, e.VideoUrl, e.ThumbnailUrl, e.DurationMinutes,
                e.VideoUrl480p, e.VideoUrl720p, e.VideoUrl1080p)).ToList();
            var castDtos = _cast.Select(cm => new VideoCastMemberItemDto(cm.Name, cm.PhotoUrl, cm.Role, cm.SortOrder)).ToList();

            if (!IsEdit)
            {
                await Mediator.Send(new CreateVideoCommand(
                    _title, _originalTitle, _desc, _posterUrl, _bannerUrl, _type, _status, _rating,
                    _language, _country, _year, _durationMinutes, _imdbRating, _videoUrl, _featured,
                    _genreIds.ToList(), episodeDtos, castDtos, _linkedComicId,
                    _videoUrl480p, _videoUrl720p, _videoUrl1080p));
            }
            else
            {
                await Mediator.Send(new UpdateVideoCommand(
                    Id, _title, _originalTitle, _desc, _posterUrl, _bannerUrl, _type, _status, _rating,
                    _language, _country, _year, _durationMinutes, _imdbRating, _videoUrl, _featured,
                    _genreIds.ToList(), episodeDtos, castDtos, _linkedComicId,
                    _videoUrl480p, _videoUrl720p, _videoUrl1080p));
            }

            Snackbar.Add("✅ Saqlandi!", Severity.Success);
            Nav.NavigateTo("/admin/videos");
        }
        catch (Exception ex) { Snackbar.Add($"Xatolik: {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }
}
