        {
            new("480p",  () => VideoUrl480p  ?? "", v => VideoUrl480p  = v),
            new("720p",  () => VideoUrl720p  ?? "", v => VideoUrl720p  = v),
            new("1080p", () => VideoUrl1080p ?? "", v => VideoUrl1080p = v),
        };
