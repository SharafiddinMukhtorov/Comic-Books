    class CastRow
    {
        public string LocalId { get; } = Guid.NewGuid().ToString("N");
        public string Name { get; set; } = "";
        public string? PhotoUrl { get; set; }
        public CastRole Role { get; set; } = CastRole.Actor;
        public int SortOrder { get; set; } = 0;
    }

    string _title = "", _originalTitle = "", _desc = "", _language = "", _country = "", _posterUrl = "", _bannerUrl = "", _videoUrl = "";
    string? _videoUrl480p, _videoUrl720p, _videoUrl1080p;
    VideoType   _type   = VideoType.Movie;
    VideoStatus _status = VideoStatus.Ongoing;
    ContentRating _rating = ContentRating.Teen;
    int? _year;
    int? _durationMinutes;
    double _imdbRating = 0;
    bool _featured;
    IEnumerable<Guid> _genreIds = new HashSet<Guid>();

    List<EpisodeRow> _episodes = new();
    List<CastRow> _cast = new();

    List<QualityField>? _movieQualityFieldsCache;
    List<QualityField> _movieQualityFields => _movieQualityFieldsCache ??= new()
    {
        new("480p",  () => _videoUrl480p  ?? "", v => _videoUrl480p  = v),
        new("720p",  () => _videoUrl720p  ?? "", v => _videoUrl720p  = v),
        new("1080p", () => _videoUrl1080p ?? "", v => _videoUrl1080p = v),
    };

    List<QualityField> EpisodeQualityFields(EpisodeRow ep) => ep.QualityFields;

    List<GenreDto> _genres = new();
    bool _loading = true;
    bool _saving = false;
    bool _uploadingPoster = false;
    bool _uploadingBanner = false;
    bool _uploadingMovieVideo = false;
    Guid _loadedId;

    Guid? _linkedComicId;
    LinkedComicSummaryDto? _linkedComic;
    string _comicSearch = "";
    List<ComicDto> _comicResults = new();

    protected override async Task OnInitializedAsync()
    {
        _genres = await Mediator.Send(new GetAllGenresQuery());

        if (IsEdit)
            await LoadVideo();

        _loadedId = Id;
        _loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id != _loadedId && _loadedId != Guid.Empty)
        {
            _loadedId = Id;
            _loading = true;
            StateHasChanged();

            _genres = await Mediator.Send(new GetAllGenresQuery());
            if (IsEdit) await LoadVideo();
            else Reset();

            _loading = false;
        }
    }

    async Task LoadVideo()
    {
        var v = await Mediator.Send(new GetVideoByIdQuery(Id));
        if (v is null) { Nav.NavigateTo("/admin/videos"); return; }

        _title = v.Title; _originalTitle = v.OriginalTitle ?? "";
        _desc = v.Description ?? ""; _language = v.Language ?? ""; _country = v.Country ?? "";
        _posterUrl = v.PosterImageUrl ?? ""; _bannerUrl = v.BannerImageUrl ?? "";
        _type = v.Type; _status = v.Status; _rating = v.Rating;
        _year = v.ReleaseYear; _durationMinutes = v.DurationMinutes;
        _imdbRating = v.ImdbRating; _featured = v.IsFeatured; _videoUrl = v.VideoUrl ?? "";
        _videoUrl480p = v.VideoUrl480p; _videoUrl720p = v.VideoUrl720p; _videoUrl1080p = v.VideoUrl1080p;

        var gMap = _genres.ToDictionary(g => g.Name, g => g.Id, StringComparer.OrdinalIgnoreCase);
        _genreIds = v.Genres.Where(n => gMap.ContainsKey(n)).Select(n => gMap[n]).ToHashSet();

        _episodes = v.Episodes.Select(e => new EpisodeRow
        {
            SeasonNumber = e.SeasonNumber, EpisodeNumber = e.EpisodeNumber,
            Title = e.Title, VideoUrl = e.VideoUrl, ThumbnailUrl = e.ThumbnailUrl, DurationMinutes = e.DurationMinutes,
            VideoUrl480p = e.VideoUrl480p, VideoUrl720p = e.VideoUrl720p, VideoUrl1080p = e.VideoUrl1080p
        }).ToList();

        _cast = v.CastMembers.Select(cm => new CastRow
        {
            Name = cm.Name, PhotoUrl = cm.PhotoUrl, Role = cm.Role, SortOrder = cm.SortOrder
        }).ToList();

        if (v.LinkedComic is not null)
        {
            _linkedComicId = v.LinkedComic.Id;
            _linkedComic = v.LinkedComic;
        }
    }

    void Reset()
    {
        _title = ""; _originalTitle = ""; _desc = ""; _language = ""; _country = "";
        _posterUrl = ""; _bannerUrl = ""; _videoUrl = "";
        _videoUrl480p = null; _videoUrl720p = null; _videoUrl1080p = null;
        _type = VideoType.Movie; _status = VideoStatus.Ongoing; _rating = ContentRating.Teen;
        _year = null; _durationMinutes = null; _imdbRating = 0; _featured = false;
        _genreIds = new HashSet<Guid>();
        _episodes = new(); _cast = new();
        _linkedComicId = null; _linkedComic = null;
    }

    void AddEpisode()
    {
        var nextSeason = _episodes.Count == 0 ? 1 : _episodes.Max(e => e.SeasonNumber);
        var nextEp = _episodes.Where(e => e.SeasonNumber == nextSeason).Select(e => e.EpisodeNumber).DefaultIfEmpty(0).Max() + 1;
        _episodes.Add(new EpisodeRow { SeasonNumber = nextSeason, EpisodeNumber = nextEp });
    }

    void AddCast() => _cast.Add(new CastRow { SortOrder = _cast.Count });

    void SelectLinkedComic(ComicDto picked)
    {
        _linkedComicId = picked.Id;
        _linkedComic = new LinkedComicSummaryDto { Id = picked.Id, Title = picked.Title, CoverImageUrl = picked.CoverImageUrl, Slug = picked.Slug };
        _comicSearch = "";
        _comicResults = new();
    }

    async Task OnComicSearchChanged()
    {
        if (string.IsNullOrWhiteSpace(_comicSearch)) { _comicResults = new(); return; }
        var r = await Mediator.Send(new GetComicsQuery(PageSize: 15, Search: _comicSearch, SortBy: "rating"));
        _comicResults = r.Items.ToList();
    }

    async Task UploadAsync(InputFileChangeEventArgs e, string kind)
    {
        var file = e.File;
        if (file is null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" };
        if (!allowed.Contains(ext))
        {
            Snackbar.Add("❌ Faqat jpg/png/webp/gif", Severity.Error);
            return;
        }

        if (kind == "videoposter") _uploadingPoster = true;
        if (kind == "videobanner") _uploadingBanner = true;
        StateHasChanged();

        try
        {
            var url = await SaveUploadedFileAsync(file, ext, kind);
            if (kind == "videoposter") _posterUrl = url;
            if (kind == "videobanner") _bannerUrl = url;
            Snackbar.Add("✅ Yuklandi", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"❌ Xato: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploadingPoster = false;
            _uploadingBanner = false;
            StateHasChanged();
        }
    }

    async Task UploadCastPhotoAsync(InputFileChangeEventArgs e, CastRow cm)
    {
        var file = e.File;
        if (file is null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" };
        if (!allowed.Contains(ext))
        {
            Snackbar.Add("❌ Faqat jpg/png/webp/gif", Severity.Error);
            return;
        }

