@page "/admin/featured"
@layout AdminLayout
@inject IMediator Mediator
@inject ISnackbar Snackbar

<PageTitle>Featured Carousel - Admin</PageTitle>

<style>
    .fc-row {
        display: flex; align-items: center; gap: 12px;
        padding: 8px 10px; border-radius: 8px; margin-bottom: 5px;
    }
    .fc-row-left  { background: rgba(65,159,217,0.08); border: 1px solid rgba(65,159,217,0.18); }
    .fc-row-right { transition: background 0.15s; }
    .fc-row-right:hover { background: rgba(128,128,128,0.07); }
    .fc-thumb { width: 38px; height: 54px; object-fit: cover; border-radius: 5px; flex-shrink: 0; }
    .fc-info  { flex: 1; min-width: 0; }
    .fc-title { font-weight: 700; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fc-meta  { font-size: 11px; opacity: 0.5; }
</style>

<MudText Typo="Typo.h5" Class="mb-1">🎠 Carousel boshqaruvi</MudText>
<MudText Typo="Typo.body2" Style="opacity:0.6" Class="mb-4">
    Bosh sahifa carousel'ida ko'rsatiladigan comiclarni tanlang (max 12 ta)
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <!-- Tanlangan comiclar -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="min-height:520px;">
                <MudText Typo="Typo.h6" Class="mb-3">✅ Carousel'da (@_featuredIds.Count/12)</MudText>

                @if (_featuredIds.Count == 0)
                {
                    <div style="text-align:center;opacity:0.35;padding:60px 0;">
                        <div style="font-size:44px">🎠</div>
                        <div style="margin-top:8px">Hech narsa tanlanmagan</div>
                    </div>
                }
                else
                {
                    @foreach (var item in _allComics.Where(c => _featuredIds.Contains(c.Id)).ToList())
                    {
                        var id = item.Id;
                        <div class="fc-row fc-row-left">
                            <img class="fc-thumb"
                                 src="@(item.CoverImageUrl ?? $"https://picsum.photos/seed/{item.Slug}/80/110")"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(item.Slug)x/80/110'" />
                            <div class="fc-info">
                                <div class="fc-title">@item.Title</div>
                                <div class="fc-meta">★ @item.AverageRating.ToString("F1") · @item.Type</div>
                            </div>
                            <MudChip T="string"
                                     Color="Color.Error"
                                     Size="Size.Small"
                                     OnClick="@(() => Toggle(id))"
                                     Style="cursor:pointer;font-weight:700;">✕</MudChip>
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>

        <!-- Barcha comiclar -->
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Style="min-height:520px;">
                <MudText Typo="Typo.h6" Class="mb-3">📚 Barcha comiclar</MudText>

                <MudTextField @bind-Value="_search"
                              Label="Qidirish..."
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="mb-3"
                              Immediate="true" />

                <div style="max-height:440px;overflow-y:auto;">
                    @foreach (var item in _allComics.Where(c => !_featuredIds.Contains(c.Id)).ToList())
                    {
                        var id = item.Id;
                        bool canAdd = _featuredIds.Count < 12;

                        <div class="fc-row fc-row-right">
                            <img class="fc-thumb"
                                 src="@(item.CoverImageUrl ?? $"https://picsum.photos/seed/{item.Slug}/80/110")"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(item.Slug)x/80/110'" />
                            <div class="fc-info">
                                <div class="fc-title">@item.Title</div>
                                <div class="fc-meta">★ @item.AverageRating.ToString("F1") · @item.Type</div>
                            </div>
                            <MudChip T="string"
                                     Color="@(canAdd ? Color.Success : Color.Default)"
                                     Size="Size.Small"
                                     Disabled="@(!canAdd)"
                                     OnClick="@(() => Toggle(id))"
                                     Style="cursor:pointer;font-weight:700;">+</MudChip>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div style="margin-top:20px;display:flex;justify-content:flex-end;gap:12px;">
        <MudButton Variant="Variant.Outlined" OnClick="@LoadData" Disabled="@_saving">
            ↺ Bekor qilish
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@Save" Disabled="@_saving"
                   Style="min-width:150px;font-weight:700;">
            @(_saving ? "Saqlanmoqda..." : "💾 Saqlash")
        </MudButton>
    </div>
}

@code {
    List<ComicDto> _allComics = new();
    HashSet<Guid> _featuredIds = new();
    bool _loading = true;
    bool _saving  = false;
    private string _search = "";

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task OnSearchChanged(string val)
    {
        _search = val;

        if (string.IsNullOrWhiteSpace(val))
        {
            var result = await Mediator.Send(new GetComicsQuery(PageSize: 200, SortBy: "rating"));
            _allComics = result.Items.ToList();
        }
        else
        {
            var result = await Mediator.Send(new GetComicsQuery(PageSize: 50, Search: val, SortBy: "rating"));
            _allComics = result.Items.ToList();
        }

        StateHasChanged();
    }

    async Task LoadData()
    {
        _loading = true;
        StateHasChanged();

        var all = await Mediator.Send(new GetComicsQuery(PageSize: 200, SortBy: "rating"));
        _allComics = all.Items.ToList();

        var feat = await Mediator.Send(new GetComicsQuery(PageSize: 100, IsFeatured: true, SortBy: "rating"));
        _featuredIds = feat.Items.Select(c => c.Id).ToHashSet();

        _loading = false;
    }

    void Toggle(Guid id)
    {
        if (_featuredIds.Contains(id))
            _featuredIds.Remove(id);
        else if (_featuredIds.Count < 12)
            _featuredIds.Add(id);
    }

    async Task OnSearch(string val)
    {
        _search = val;
        var r = string.IsNullOrWhiteSpace(val)
            ? await Mediator.Send(new GetComicsQuery(PageSize: 200, SortBy: "rating"))
            : await Mediator.Send(new GetComicsQuery(PageSize: 50, Search: val, SortBy: "rating"));
        _allComics = r.Items.ToList();
    }

    async Task Save()
    {
        _saving = true;
        try
        {
            await Mediator.Send(new ToggleFeaturedCommand(_featuredIds.ToList()));
            Snackbar.Add($"✅ {_featuredIds.Count} ta comic saqlandi!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Xatolik: {ex.Message}", Severity.Error);
        }
        finally { _saving = false; }
    }
}
