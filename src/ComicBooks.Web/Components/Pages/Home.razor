@code {
    private int _activeIndex = 0;
    private System.Threading.Timer? _autoTimer;

    PaginatedList<ComicDto>? _featured, _trending, _latest;
    ComicDto? _adminPick;
    bool _loading = true;
    int _tab = 0;
    int _latestPage = 1;
    const int LatestPageSize = 12;   // So'nggi yangilanishlar: 12/sahifa (2 ustunda 6 to'liq qator)
    const int RatingTop = 10;        // Reytinglar: 10 ta (paginationsiz)

    protected override async Task OnInitializedAsync()
    {
        _featured = await Mediator.Send(new GetComicsQuery(PageSize: 12, IsFeatured: true, SortBy: "rating"));
        // Karusel chap tomoni bo'sh qolmasligi uchun 3-kartadan boshlanadi
        if (_featured != null && _featured.Items.Count > 0)
            _activeIndex = Math.Min(2, _featured.Items.Count - 1);
        _trending = await Mediator.Send(new GetComicsQuery(PageSize: 25, SortBy: "views"));
        _latest   = await Mediator.Send(new GetComicsQuery(PageSize: 300, SortBy: "createdAt"));
        var pick  = await Mediator.Send(new GetComicsQuery(PageSize: 1, IsAdminPick: true));
        _adminPick = pick.Items.FirstOrDefault();
        _loading  = false;
        // Avto-aylanish o'chirilgan — foydalanuvchi o'zi suradi
    }

    void NextSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex + 1) % count;
    }

    void PrevSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex - 1 + count) % count;
    }

    // ── Carousel yordamchilari ──
    // Aylana (loop) offset: markazga nisbatan chap(-)/o'ng(+) joylashuv
    int CircularOffset(int i, int active, int count)
    {
        int o = i - active;
        if (count > 1)
        {
            if (o > count / 2) o -= count;
            else if (o < -(count / 2)) o += count;
        }
        return o;
    }

    // Har karta uchun inline transform: markazlash + offset siljish + markaz kattalashishi.
    // Markaz karta kattalashgani uchun oddiy "step*off" bilan bo'shliqlar notekis chiqardi
    // (markaz atrofida torroq, uzoqroqda kengroq). Endi HAR BIR bo'shliq --cf-gap ga teng
    // bo'lishi uchun siljishni kartalar kengligi + gap yig'indisi sifatida hisoblaymiz,
    // markaz kartaning qo'shimcha (kattalashgan) yarim kengligini alohida qo'shib.
    string CardStyle(int off)
    {
        int ao = Math.Abs(off);
        string scale = off == 0 ? "var(--cf-cscale)" : "1";
        string opacity = "1";
        int z = off == 0 ? 10 : Math.Max(1, 5 - ao);
        string pe = "auto";
        string translateX = off == 0
            ? "0px"
            : $"calc({(off > 0 ? "" : "-1 * ")}({ao} * (var(--cf-card-w) + var(--cf-gap)) + var(--cf-card-w) * (var(--cf-cscale) - 1) / 2))";
        return $"transform:translate(-50%,-50%) translateX({translateX}) scale({scale});opacity:{opacity};z-index:{z};pointer-events:{pe};";
    }

    void CardClick(int i)
    {
        var its = _featured?.Items;
        if (its == null || i < 0 || i >= its.Count) return;
        if (i == _activeIndex)
            Nav.NavigateTo($"/comic/{its[i].Slug}");   // markazdagi karta → komik sahifasi
        else
            _activeIndex = i;                            // yon karta → markazga keltirish
    }

    // ── Swipe (touch) support ──────────────────────────────
    double _touchStartX;
    const int SwipeThreshold = 50;

    void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
            _touchStartX = e.Touches[0].ClientX;
    }

    void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        var dx = e.ChangedTouches[0].ClientX - _touchStartX;
        if (Math.Abs(dx) < SwipeThreshold) return;
        if (dx < 0) NextSlide(); else PrevSlide();
    }

    // 3 ta tab ham bitta pooldan (always populated), xotirada turlicha saralanadi
    List<ComicDto> TabList()
    {
        var pool = _trending?.Items ?? new List<ComicDto>();
        return _tab switch
        {
            0 => pool.OrderByDescending(c => c.ViewCount).ToList(),       // Haftalik
            1 => pool.OrderByDescending(c => c.AverageRating).ToList(),   // Oylik
            _ => pool.OrderByDescending(c => c.BookmarkCount).ToList(),   // Hammasi
        };
    }

    // Reytinglar: faqat 10 ta (paginationsiz)
    List<ComicDto> TabListTop() => TabList().Take(RatingTop).ToList();

    // So'nggi yangilanishlar: 10/sahifa pagination
    // Oxirgi bob qo'shilgan (yoki yangi qo'shilgan) bo'yicha xotirada saralanadi
    List<ComicDto> LatestAll() =>
        (_latest?.Items ?? new List<ComicDto>())
            .OrderByDescending(c => c.LastUpdatedAt)
            .ToList();
    List<ComicDto> LatestPaged() =>
        LatestAll().Skip((_latestPage - 1) * LatestPageSize).Take(LatestPageSize).ToList();

    int TotalLatestPages()
    {
        var total = LatestAll().Count;
        if (total == 0) return 0;
        return (int)Math.Ceiling(total / (double)LatestPageSize);
    }

    async Task SetLatestPage(int p)
    {
        var max = TotalLatestPages();
        _latestPage = Math.Clamp(p, 1, Math.Max(max, 1));
        // Sahifa almashganda "So'nggi yangilanishlar" boshiga olib kelamiz (sakrab ketmasin)
        try { await JS.InvokeVoidAsync("scrollToEl", "latest-top"); } catch { }
    }

    static string FmtViews(int n)
    {
        if (n >= 1_000_000) return (n / 1_000_000.0).ToString("F1") + "M";
        if (n >= 1_000)     return (n / 1_000.0).ToString("F1") + "K";
        return n.ToString();
    }

    string FmtDate(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalHours < 1)  return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays  < 7)  return $"{(int)diff.TotalDays} kun oldin";
        return $"{(int)(diff.TotalDays/7)} hafta oldin";
    }


    string RankStyle(int r) => r switch
    {
        1 => "background:#3b82f6;color:#fff;",
        2 => "background:#3b82f6;color:#fff;",
        3 => "background:#3b82f6;color:#fff;",
        _ => "background:#3b82f6;color:#fff;"
    };

    public void Dispose() => _autoTimer?.Dispose();
}
