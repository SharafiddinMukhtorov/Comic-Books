        .lr-chap-badge {
            font-size: 13px !important;
        }
        .lr-chap-time {
            font-size: 11px !important;
        }

        /* ── REYTINGLAR (Popular) ──────────────────────────────── */
        .ratings-sidebar {
            padding-top: 28px;
            border-top: 1px solid var(--mud-palette-lines-default);
            margin-top: 24px;
            min-width: 0;     /* grid item overflow oldini oladi */
            overflow: hidden;
        }
        .ratings-sidebar a {
            display: block;
            min-width: 0;
            overflow: hidden;
        }
        .ratings-sidebar a > div {
            min-height: 84px !important;
            padding: 10px 8px !important;
            gap: 12px !important;
            overflow: hidden;
        }
        .ratings-sidebar a > div > div:first-child {
            /* Raqamli nishon: ref badge 32×32 */
            width: 32px !important;
            height: 32px !important;
            border-radius: 8px !important;
            font-size: 13px !important;
        }
        .ratings-sidebar a > div > img {
            width: 56px !important;      /* ref: w-14 = 56px */
            height: 72px !important;     /* ref: h-[72px]    */
            border-radius: 6px !important;
        }
        .ratings-sidebar a > div > div:nth-child(3) > div:first-child {
            font-size: 14px !important;  /* ref: span 14px font-medium */
            font-weight: 700 !important;
            line-height: 1.3 !important;
        }
        .ratings-sidebar a > div > div:nth-child(3) > div:nth-child(2) {
            font-size: 12px !important;  /* janr: 12px */
        }
        .ratings-sidebar a > div > div:nth-child(3) > div:last-child {
            font-size: 12px !important;  /* ref: svg w-3 h-3 (12px) + italic 12px */
        }
        /* Tab tugmalar: Haftalik / Oylik / Hammasi (segmented) */
        .ratings-sidebar .rt-seg-btn {
            padding: 6px 11px !important;
            font-size: 11px !important;
        }

        /* ── SAHIFALASH (Pagination) ───────────────────────────── */
        /* ref: div 400×32, mt-4=16px, gap-2=8px, tugma 32×32     */
        .rating-pagination {
            gap: 8px;                   /* ref: gap-2 = 8px  */
            margin-top: 16px;           /* ref: mt-4  = 16px */
            padding-top: 16px;          /* raqamlar oxirgi itemga yopishmasin */
        }
        .rp-btn {
            min-width: 32px;            /* ref: w-8 = 32px */
            height: 32px;               /* ref: h-8 = 32px */
            font-size: 12px;            /* ref: text-xs    */
            padding: 0 6px;
        }
    }
</style>

@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;height:80vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    var items = _featured?.Items ?? new();
    var active = items.Count > 0 ? items[_activeIndex % items.Count] : null;

    <!-- ════ Coverflow Carousel (Asura uslubi) ════ -->
    <div class="cf-wrapper"
         @ontouchstart="@OnTouchStart"
         @ontouchend="@OnTouchEnd">
        @if (active != null)
        {
            <div class="cf-bg"
                 style="background-image: url('@(active.CoverImageUrl ?? $"https://picsum.photos/seed/{active.Slug}/1200/500")');">
            </div>
        }

        <div class="cf-stage">
            @for (int i = 0; i < items.Count; i++)
            {
                int idx = i;
                var c = items[idx];
                int off = CircularOffset(idx, _activeIndex, items.Count);
                bool isCenter = off == 0;
                <div class="cf-card @(isCenter ? "cf-center" : "")" style="@CardStyle(off)" @onclick="@(() => CardClick(idx))">
                    <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/350/500")"
                         onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)cv/350/500'"
                         alt="@c.Title" />
                    @if (isCenter)
                    {
                        <div class="cf-rating"><span class="star-ic"></span> @c.AverageRating.ToString("F1")</div>
                        <div class="cf-card-title">@c.Title</div>
                    }
                </div>
            }
        </div>

    </div>

    <!-- BODY -->
    <div class="home-body @(Theme.IsDark ? "" : "hb-light")" style="max-width:1300px;margin:0 auto;padding:32px 20px 40px;">

        <!-- Mashhur (trending cards) -->
        <div style="margin-bottom:40px;">
            <div class="section-header">
                <span class="section-title">Mashhur</span>
                <a href="/comics?sortBy=rating"
                   style="@($"font-size:13px;font-weight:700;color:{(Theme.IsDark?"#60a5fa":"#2D6BFF")};text-decoration:none;")">
                    Barchasi →
                </a>
            </div>
            <div class="trending-scroll">
                @foreach (var c in (_trending?.Items ?? new()).Take(8))
                {
                    <a href="/comic/@c.Slug" class="trending-card">
                        <div class="trending-card-img-wrap">
                            <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/300/420")"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)t/300/420'"
                                 alt="@c.Title" />
                        </div>
                        <div class="trending-info">
                            <div style="font-weight:700;font-size:13px;margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @c.Title
                            </div>
                            <div style="font-size:11px;font-weight:500;opacity:0.5;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                Bob @((int)(c.LatestChapterNumber ?? c.ChapterCount))
                            </div>
                            <div class="tc-stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="tc-star @(s <= (int)Math.Round(c.AverageRating/2) ? "" : "empty")"></span>
                                }
                                <span style="font-size:10.5px;color:#FACC15;font-weight:700;margin-left:3px;">@c.AverageRating.ToString("F1")</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- Latest Updates + Popular sidebar -->
        <div class="latest-grid">

            <!-- Latest Updates -->
            <div>
                <div class="section-header" id="latest-top" style="scroll-margin-top:80px;">
                    <span class="section-title">So'nggi yangilanishlar</span>
                </div>
                <div class="latest-updates-grid @(Theme.IsDark ? "" : "lt-mode")" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    @foreach (var c in LatestPaged())
                    {
                        <a href="/comic/@c.Slug" style="text-decoration:none;color:inherit;">
                            <div class="latest-row">
                                <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/82/110")"
                                     style="width:64px;height:86px;object-fit:cover;border-radius:6px;flex-shrink:0;"
                                     onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)l/82/110'" />
                                <div class="lr-content">
                                    <div class="lr-title" style="font-weight:700;font-size:13px;margin-bottom:5px;">@c.Title</div>
                                    @{
                                        var statusCls = c.Status.ToString() == "Completed" ? "lr-badge-complete"
                                                      : c.Status.ToString() == "Hiatus"    ? "lr-badge-hiatus"
                                                      : "lr-badge-ongoing";
                                        var statusTxt = c.Status.ToString() == "Completed" ? "Tugallangan"
                                                      : c.Status.ToString() == "Hiatus"    ? "To'xtatilgan"
                                                      : "Davom etadi";
                                    }
                                    <div class="lr-badges">
                                        @foreach (var g in c.Genres.Take(2))
                                        {
                                            <span class="lr-badge-genre">@Translate(g)</span>
                                        }
                                        <span class="@statusCls">@statusTxt</span>
                                    </div>
                                    @if (c.LatestChapterNumber.HasValue)
                                    {
                                        <div class="lr-chap" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                                            <span class="lr-chap-badge">@if (c.LatestChapterLocked) { <span class="lr-lock"></span> }Bob @((int)c.LatestChapterNumber.Value)</span>
                                            <span class="lr-chap-time">@FmtDate(c.LastUpdatedAt)</span>
                                        </div>
                                        @if (c.LatestChapterNumber.Value >= 2)
                                        {
                                            <div class="lr-chap" style="display:flex;align-items:center;justify-content:space-between;">
                                                <span style="font-size:12px;font-weight:500;opacity:0.5;">Bob @((int)c.LatestChapterNumber.Value - 1)</span>
                                                <span class="lr-chap-time">o'tgan hafta</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @* So'nggi yangilanishlar pagination (1,2,3,4) *@
                @{ var ltotal = TotalLatestPages(); }
                @if (ltotal > 1)
                {
                    <div class="rating-pagination">
                        <button class="rp-btn" disabled="@(_latestPage <= 1)" @onclick="@(() => SetLatestPage(_latestPage - 1))">‹</button>
                        @for (int p = 1; p <= ltotal; p++)
                        {
                            int pg = p;
                            <button class="rp-btn @(pg == _latestPage ? "active" : "")" @onclick="@(() => SetLatestPage(pg))">@pg</button>
                        }
                        <button class="rp-btn" disabled="@(_latestPage >= ltotal)" @onclick="@(() => SetLatestPage(_latestPage + 1))">›</button>
                    </div>
                }
            </div>

            <!-- Popular sidebar -->
            <div class="ratings-sidebar" style="@(Theme.IsDark
                    ? "background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:16px 14px;"
                    : "background:#ffffff;border:1px solid #e3e8f5;box-shadow:0 1px 3px rgba(16,24,64,0.05),0 8px 24px rgba(16,24,64,0.05);border-radius:14px;padding:16px 14px;")"
            >
                <div class="section-header" style="flex-wrap:wrap;gap:8px;">
                    <span class="section-title">Reytinglar</span>
                    <div class="rt-seg">
                        @foreach (var (label, ti) in new[] { ("Haftalik", 0), ("Oylik", 1), ("Hammasi", 2) })
                        {
                            <button class="rt-seg-btn @(_tab == ti ? "active" : "")" @onclick="@(() => _tab = ti)">@label</button>
                        }
                    </div>
                </div>
                @{ int rk = 0; }
                @foreach (var c in TabListTop())
                {
                    int r = ++rk;
                    <a href="/comic/@c.Slug" style="text-decoration:none;color:inherit;">
                        <div class="rating-item">
                            <div style="@RankStyle(r);width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;flex-shrink:0;">@r</div>
                            <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/44/60")"
                                 style="width:44px;height:60px;object-fit:cover;border-radius:5px;flex-shrink:0;"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)r/44/60'" />
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:13px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px;">@c.Title</div>
                                <div style="font-size:11px;opacity:0.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@string.Join(", ", TranslateMany(c.Genres.Take(2)))</div>
                                <div style="font-size:11px;color:#FACC15;font-weight:700;"><span class="star-ic"></span> @c.AverageRating.ToString("F1")</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
}

@code {
    private int _activeIndex = 0;
    private System.Threading.Timer? _autoTimer;

    PaginatedList<ComicDto>? _featured, _trending, _latest;
    bool _loading = true;
    int _tab = 0;
    int _latestPage = 1;
    const int LatestPageSize = 10;   // So'nggi yangilanishlar: 10/sahifa
    const int RatingTop = 10;        // Reytinglar: 10 ta (paginationsiz)

    protected override async Task OnInitializedAsync()
    {
        Theme.OnChange += Refresh;
        _featured = await Mediator.Send(new GetComicsQuery(PageSize: 12, IsFeatured: true, SortBy: "rating"));
        // Karusel chap tomoni bo'sh qolmasligi uchun 3-kartadan boshlanadi
        if (_featured != null && _featured.Items.Count > 0)
            _activeIndex = Math.Min(2, _featured.Items.Count - 1);
        _trending = await Mediator.Send(new GetComicsQuery(PageSize: 25, SortBy: "views"));
        _latest   = await Mediator.Send(new GetComicsQuery(PageSize: 300, SortBy: "createdAt"));
        _loading  = false;
        // Avto-aylanish o'chirilgan — foydalanuvchi o'zi suradi
    }

    void NextSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex + 1) % count;
    }

    void PrevSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex - 1 + count) % count;
    }

    // ── Carousel yordamchilari ──
    // Aylana (loop) offset: markazga nisbatan chap(-)/o'ng(+) joylashuv
    int CircularOffset(int i, int active, int count)
    {
        int o = i - active;
        if (count > 1)
        {
            if (o > count / 2) o -= count;
            else if (o < -(count / 2)) o += count;
        }
        return o;
    }

    // Har karta uchun inline transform: markazlash + offset siljish + markaz kattalashishi
    string CardStyle(int off)
    {
        int ao = Math.Abs(off);
        string scale = off == 0 ? "var(--cf-cscale)" : "1";
        string opacity = ao > 3 ? "0" : "1";
        int z = off == 0 ? 10 : Math.Max(1, 5 - ao);
        string pe = ao > 3 ? "none" : "auto";
        return $"transform:translate(-50%,-50%) translateX(calc(var(--cf-step) * {off})) scale({scale});opacity:{opacity};z-index:{z};pointer-events:{pe};";
    }

    void CardClick(int i)
    {
        var its = _featured?.Items;
        if (its == null || i < 0 || i >= its.Count) return;
        if (i == _activeIndex)
            Nav.NavigateTo($"/comic/{its[i].Slug}");   // markazdagi karta → komik sahifasi
        else
            _activeIndex = i;                            // yon karta → markazga keltirish
    }

    // ── Swipe (touch) support ──────────────────────────────
    double _touchStartX;
    const int SwipeThreshold = 50;

    void OnTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
            _touchStartX = e.Touches[0].ClientX;
    }

    void OnTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        var dx = e.ChangedTouches[0].ClientX - _touchStartX;
        if (Math.Abs(dx) < SwipeThreshold) return;
        if (dx < 0) NextSlide(); else PrevSlide();
    }

    // 3 ta tab ham bitta pooldan (always populated), xotirada turlicha saralanadi
    List<ComicDto> TabList()
    {
        var pool = _trending?.Items ?? new List<ComicDto>();
        return _tab switch
        {
            0 => pool.OrderByDescending(c => c.ViewCount).ToList(),       // Haftalik
            1 => pool.OrderByDescending(c => c.AverageRating).ToList(),   // Oylik
            _ => pool.OrderByDescending(c => c.BookmarkCount).ToList(),   // Hammasi
        };
    }

    // Reytinglar: faqat 10 ta (paginationsiz)
    List<ComicDto> TabListTop() => TabList().Take(RatingTop).ToList();

    // So'nggi yangilanishlar: 10/sahifa pagination
    // Oxirgi bob qo'shilgan (yoki yangi qo'shilgan) bo'yicha xotirada saralanadi
    List<ComicDto> LatestAll() =>
        (_latest?.Items ?? new List<ComicDto>())
            .OrderByDescending(c => c.LastUpdatedAt)
            .ToList();
    List<ComicDto> LatestPaged() =>
        LatestAll().Skip((_latestPage - 1) * LatestPageSize).Take(LatestPageSize).ToList();

    int TotalLatestPages()
    {
        var total = LatestAll().Count;
        if (total == 0) return 0;
        return (int)Math.Ceiling(total / (double)LatestPageSize);
    }

    async Task SetLatestPage(int p)
    {
        var max = TotalLatestPages();
        _latestPage = Math.Clamp(p, 1, Math.Max(max, 1));
        // Sahifa almashganda "So'nggi yangilanishlar" boshiga olib kelamiz (sakrab ketmasin)
        try { await JS.InvokeVoidAsync("scrollToEl", "latest-top"); } catch { }
    }

    static string FmtViews(int n)
    {
        if (n >= 1_000_000) return (n / 1_000_000.0).ToString("F1") + "M";
        if (n >= 1_000)     return (n / 1_000.0).ToString("F1") + "K";
        return n.ToString();
    }

    string FmtDate(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalHours < 1)  return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays  < 7)  return $"{(int)diff.TotalDays} kun oldin";
        return $"{(int)(diff.TotalDays/7)} hafta oldin";
    }


    string RankStyle(int r) => r switch
    {
        1 => "background:#3b82f6;color:#fff;",
        2 => "background:#3b82f6;color:#fff;",
        3 => "background:#3b82f6;color:#fff;",
        _ => "background:#3b82f6;color:#fff;"
    };

    async void Refresh() => await InvokeAsync(StateHasChanged);
    public void Dispose() { _autoTimer?.Dispose(); Theme.OnChange -= Refresh; }
}
