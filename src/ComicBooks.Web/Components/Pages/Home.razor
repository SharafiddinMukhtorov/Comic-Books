@page "/"
@inject IMediator Mediator
@inject NavigationManager Nav
@inject ThemeService Theme
@implements IDisposable

<PageTitle>Manga Dunyo - Manhwa, Manga o'qing</PageTitle>

<style>
    /* ── Hero / Carousel ── */
    .hero-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: #0a0a14;
        margin: 0;
        padding: 0;
        margin-top: -1px;  /* navbar bilan zazor olib tashlash */
    }

    .hero-bg-blur {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: blur(28px) brightness(0.35) saturate(1.4);
        transform: scale(1.08);
        transition: background-image 0.6s ease;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 420px;
        padding: 48px 60px;
        gap: 32px;
    }

    .hero-left {
        flex: 1;
        max-width: 560px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(245,158,11,0.18);
        border: 1px solid rgba(245,158,11,0.4);
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 5px 14px;
        border-radius: 999px;
        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .hero-title {
        font-size: clamp(26px, 3.5vw, 42px);
        font-weight: 900;
        color: #fff;
        line-height: 1.15;
        margin: 0 0 14px;
        text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    }

    .hero-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .hero-genre-tag {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.85);
        border-radius: 6px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .hero-rating {
        color: #f59e0b;
        font-weight: 800;
        font-size: 14px;
    }

    .hero-views {
        color: rgba(255,255,255,0.5);
        font-size: 12px;
    }

    .hero-read-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #1b13be, #419fd9);
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 14px 32px;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 6px 24px rgba(27,19,190,0.45);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hero-read-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 32px rgba(27,19,190,0.6);
        color: #fff;
    }

    .hero-right {
        flex-shrink: 0;
        position: relative;
    }

    .hero-cover {
        width: 175px;
        height: 250px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.12);
        transition: opacity 0.4s ease;
    }

    .hero-cover-year {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.7);
        color: rgba(255,255,255,0.7);
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 6px;
        white-space: nowrap;
    }

    /* Dots */
    .hero-dots {
        position: absolute;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 5;
    }

    .hero-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.35);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.25s;
    }

    .hero-dot.active {
        background: #fff;
        width: 22px;
        border-radius: 4px;
    }

    /* ── Section header ── */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .section-title {
        font-size: 1.05rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 20px;
        background: linear-gradient(180deg, #030082, #419fd9);
        border-radius: 2px;
    }

    /* Trending — 4-col grid */
    .trending-scroll {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    @@media (max-width: 1100px) and (min-width: 769px) {
        .trending-scroll { grid-template-columns: repeat(3, 1fr); }
    }

    .trending-card {
        border-radius: 14px;
        overflow: hidden;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 6px 20px rgba(0,0,0,0.22);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
    }

    .trending-card:hover { transform: translateY(-6px); box-shadow: 0 14px 36px rgba(0,0,0,0.34); }

    .trending-card img {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        display: block;
    }

    .trending-card-rating {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(0,0,0,0.78);
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 7px;
        backdrop-filter: blur(4px);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .trending-card-views {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background: rgba(0,0,0,0.78);
        color: rgba(255,255,255,0.9);
        font-size: 12px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 7px;
        backdrop-filter: blur(4px);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .trending-card-img-wrap { position: relative; }

    .trending-info {
        padding: 10px 10px 12px;
        background: var(--mud-palette-surface);
    }

    .trending-info .tc-stars {
        display: flex;
        align-items: center;
        gap: 1px;
        margin-top: 4px;
    }
    .trending-info .tc-star      { font-size: 11px; color: #f59e0b; }
    .trending-info .tc-star.empty{ color: rgba(128,128,128,0.35); }

    /* Rating pagination */
    .rating-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
        padding-top: 14px;
    }
    .rp-btn {
        min-width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid rgba(128,128,128,0.25);
        background: transparent;
        color: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        padding: 0 8px;
        transition: all 0.15s;
    }
    .rp-btn:hover:not(:disabled) { background: rgba(27,19,190,0.12); border-color: rgba(27,19,190,0.4); }
    .rp-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .rp-btn.active { background: #1b13be; color: #fff; border-color: #1b13be; }

    .latest-row {
        display: flex;
        gap: 10px;
        padding: 10px 8px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        cursor: pointer;
        transition: background 0.15s;
        border-radius: 8px;
    }

    .latest-row:hover { background: rgba(65,159,217,0.08); }

    /* ── Latest grid (desktop: 2-col, mobile: 1-col) ── */
    .latest-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 32px;
    }

    @@media (max-width: 768px) {
        /* Hero adjustments */
        .hero-content {
            padding: 14px 16px 24px;
            min-height: 0;          /* tepada bo'sh joy bo'lmasin */
            align-items: flex-start; /* kontent yuqorida tursin, markazda emas */
            gap: 14px;
        }
        .hero-badge {
            margin-bottom: 8px !important;
        }
        .hero-wrapper { min-height: auto; }
        .hero-bg, .hero-bg-grad { min-height: auto; }
        .hero-right {
            flex-shrink: 0;
        }
        .hero-cover {
            width: 110px;
            height: 158px;
        }
        .hero-title  { font-size: 20px; }
        .hero-badge  { font-size: 11px; padding: 4px 11px; }
        .hero-read-btn { padding: 11px 22px; font-size: 14px; }
        .hero-meta   { gap: 10px; margin-bottom: 18px; }

        /* Body container */
        .home-body { padding: 20px 14px 80px !important; }

        /* Trending: 2 ustun mobilda */
        .trending-scroll { grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .trending-card img { aspect-ratio: 3/4; }

        /* Latest grid: single column on mobile */
        .latest-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        /* Latest rows: full width, single column */
        .latest-updates-grid { grid-template-columns: 1fr !important; }

        /* Ratings sidebar: smaller padding */
        .ratings-sidebar { padding-top: 28px; border-top: 1px solid var(--mud-palette-lines-default); margin-top: 24px; }
    }
</style>

@if (_loading)
{
    <div style="display:flex;justify-content:center;align-items:center;height:80vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    var items = _featured?.Items ?? new();
    var active = items.Count > 0 ? items[_activeIndex % items.Count] : null;

    <!-- Hero Carousel -->
    <div class="hero-wrapper">
        @if (active != null)
        {
            <div class="hero-bg-blur"
                 style="background-image: url('@(active.CoverImageUrl ?? $"https://picsum.photos/seed/{active.Slug}/1200/500")');">
            </div>
        }

        <div class="hero-content">
            @if (active != null)
            {
                <div class="hero-left">
                    <div class="hero-badge">⭐ Eng mashhur</div>
                    <h1 class="hero-title">@active.Title</h1>
                    <div class="hero-meta">
                        @foreach (var g in active.Genres.Take(2))
                        {
                            <span class="hero-genre-tag">@g</span>
                        }
                        <span class="hero-rating">★ @active.AverageRating.ToString("F1")</span>
                        <span class="hero-views">@active.ViewCount ko'rishlar</span>
                    </div>
                    <a class="hero-read-btn" href="/comic/@active.Slug">
                        ▶ &nbsp;Hozir o'qish
                    </a>
                </div>

                <div class="hero-right">
                    <img class="hero-cover"
                         src="@(active.CoverImageUrl ?? $"https://picsum.photos/seed/{active.Slug}/350/500")"
                         onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(active.Slug)cv/350/500'"
                         alt="@active.Title" />
                    <div class="hero-cover-year">🏆 @DateTime.Now.Year</div>
                </div>
            }
        </div>

        <div class="hero-dots">
            @for (int i = 0; i < items.Count; i++)
            {
                int idx = i;
                <button class="hero-dot @(_activeIndex == idx ? "active" : "")"
                        @onclick="@(() => _activeIndex = idx)"></button>
            }
        </div>
    </div>

    <!-- BODY -->
    <div class="home-body" style="max-width:1300px;margin:0 auto;padding:32px 20px 80px;">

        <!-- Mashhur (trending cards) -->
        <div style="margin-bottom:40px;">
            <div class="section-header">
                <span class="section-title">Mashhur</span>
                <a href="/comics?sortBy=rating"
                   style="@($"font-size:13px;font-weight:700;color:{(Theme.IsDark?"#5b8af0":"#2563eb")};text-decoration:none;")">
                    Barchasi →
                </a>
            </div>
            <div class="trending-scroll">
                @foreach (var c in (_trending?.Items ?? new()).Take(8))
                {
                    <a href="/comic/@c.Slug" class="trending-card">
                        <div class="trending-card-img-wrap">
                            <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/300/420")"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)t/300/420'"
                                 alt="@c.Title" />
                            <div class="trending-card-rating">★ @c.AverageRating.ToString("F1")</div>
                            <div class="trending-card-views">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                @FmtViews(c.ViewCount)
                            </div>
                        </div>
                        <div class="trending-info">
                            <div style="font-weight:700;font-size:13px;margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @c.Title
                            </div>
                            <div style="font-size:11px;opacity:0.5;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                Chapter @((int)(c.LatestChapterNumber ?? c.ChapterCount))
                            </div>
                            <div class="tc-stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="tc-star @(s <= (int)Math.Round(c.AverageRating/2) ? "" : "empty")">★</span>
                                }
                                <span style="font-size:10.5px;color:#f59e0b;font-weight:700;margin-left:3px;">@c.AverageRating.ToString("F1")</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- Latest Updates + Popular sidebar -->
        <div class="latest-grid">

            <!-- Latest Updates -->
            <div>
                <div class="section-header">
                    <span class="section-title">So'nggi yangilanishlar</span>
                </div>
                <div class="latest-updates-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:0;">
                    @foreach (var c in _latest?.Items ?? new())
                    {
                        <a href="/comic/@c.Slug" style="text-decoration:none;color:inherit;">
                            <div class="latest-row">
                                <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/80/110")"
                                     style="width:58px;height:80px;object-fit:cover;border-radius:5px;flex-shrink:0;"
                                     onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)l/80/110'" />
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:700;font-size:13px;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@c.Title</div>
                                    @if (c.LatestChapterNumber.HasValue)
                                    {
                                        <div style="font-size:12px;opacity:0.7;display:flex;justify-content:space-between;">
                                            <span>Ch. @((int)c.LatestChapterNumber.Value)</span>
                                            <span style="opacity:0.4;font-size:11px;">@FmtDate(c.CreatedAt)</span>
                                        </div>
                                        @if (c.LatestChapterNumber.Value >= 2)
                                        {
                                            <div style="font-size:12px;color:@(Theme.IsDark ? "#5b8af0" : "#2563eb");display:flex;justify-content:space-between;">
                                                <span>Ch. @((int)c.LatestChapterNumber.Value - 1)</span>
                                                <span style="opacity:0.35;font-size:11px;">o'tgan hafta</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <!-- Popular sidebar -->
            <div class="ratings-sidebar">
                <div class="section-header" style="flex-wrap:wrap;gap:8px;">
                    <span class="section-title">Reytinglar</span>
                    <div style="display:flex;gap:4px;">
                        @foreach (var (label, ti) in new[] { ("Haftalik", 0), ("Oylik", 1), ("Hammasi", 2) })
                        {
                            <button @onclick="@(() => { _tab = ti; _ratingPage = 1; })" style="@TabBtn(_tab == ti)">@label</button>
                        }
                    </div>
                </div>
                @{ int rk = (_ratingPage - 1) * RatingPageSize; }
                @foreach (var c in TabListPaged())
                {
                    int r = ++rk;
                    <a href="/comic/@c.Slug" style="text-decoration:none;color:inherit;">
                        <div style="display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid rgba(128,128,128,0.08);cursor:pointer;">
                            <div style="@RankStyle(r);width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;flex-shrink:0;">@r</div>
                            <img src="@(c.CoverImageUrl ?? $"https://picsum.photos/seed/{c.Slug}/44/60")"
                                 style="width:44px;height:60px;object-fit:cover;border-radius:5px;flex-shrink:0;"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(c.Slug)r/44/60'" />
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:13px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px;">@c.Title</div>
                                <div style="font-size:11px;opacity:0.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@string.Join(", ", c.Genres.Take(2))</div>
                                <div style="font-size:11px;color:#f59e0b;font-weight:700;">★ @c.AverageRating.ToString("F1")</div>
                            </div>
                        </div>
                    </a>
                }

                @{ var total = TotalRatingPages(); }
                @if (total > 1)
                {
                    <div class="rating-pagination">
                        <button class="rp-btn" disabled="@(_ratingPage <= 1)" @onclick="@(() => SetRatingPage(_ratingPage - 1))">‹</button>
                        @for (int p = 1; p <= total; p++)
                        {
                            int pg = p;
                            <button class="rp-btn @(pg == _ratingPage ? "active" : "")" @onclick="@(() => SetRatingPage(pg))">@pg</button>
                        }
                        <button class="rp-btn" disabled="@(_ratingPage >= total)" @onclick="@(() => SetRatingPage(_ratingPage + 1))">›</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private int _activeIndex = 0;
    private System.Threading.Timer? _autoTimer;

    PaginatedList<ComicDto>? _featured, _trending, _popular, _latest;
    bool _loading = true;
    int _tab = 0;
    int _ratingPage = 1;
    const int RatingPageSize = 5;

    protected override async Task OnInitializedAsync()
    {
        Theme.OnChange += Refresh;
        _featured = await Mediator.Send(new GetComicsQuery(PageSize: 12, IsFeatured: true, SortBy: "rating"));
        _trending = await Mediator.Send(new GetComicsQuery(PageSize: 25, SortBy: "views"));
        _popular  = await Mediator.Send(new GetComicsQuery(PageSize: 25, IsPopular: true, SortBy: "rating"));
        _latest   = await Mediator.Send(new GetComicsQuery(PageSize: 14, SortBy: "createdAt"));
        _loading  = false;

        _autoTimer = new System.Threading.Timer(_ =>
        {
            var count = _featured?.Items?.Count ?? 0;
            if (count > 1)
            {
                _activeIndex = (_activeIndex + 1) % count;
                InvokeAsync(StateHasChanged);
            }
        }, null, 5000, 5000);
    }

    void NextSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex + 1) % count;
    }

    void PrevSlide()
    {
        var count = _featured?.Items?.Count ?? 1;
        _activeIndex = (_activeIndex - 1 + count) % count;
    }

    List<ComicDto> TabList() =>
        (_tab == 0 ? _trending?.Items : _popular?.Items) ?? new List<ComicDto>();

    List<ComicDto> TabListPaged() =>
        TabList().Skip((_ratingPage - 1) * RatingPageSize).Take(RatingPageSize).ToList();

    int TotalRatingPages()
    {
        var total = TabList().Count;
        if (total == 0) return 0;
        return (int)Math.Ceiling(total / (double)RatingPageSize);
    }

    void SetRatingPage(int p)
    {
        var max = TotalRatingPages();
        _ratingPage = Math.Clamp(p, 1, Math.Max(max, 1));
    }

    static string FmtViews(int n)
    {
        if (n >= 1_000_000) return (n / 1_000_000.0).ToString("F1") + "M";
        if (n >= 1_000)     return (n / 1_000.0).ToString("F1") + "K";
        return n.ToString();
    }

    string FmtDate(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalHours < 1)  return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays  < 7)  return $"{(int)diff.TotalDays} kun oldin";
        return $"{(int)(diff.TotalDays/7)} hafta oldin";
    }

    string TabBtn(bool on) => on
        ? $"background:{(Theme.IsDark ? "#1b13be" : "#419fd9")};color:#fff;font-size:11px;font-weight:700;padding:6px 16px;border-radius:9999px;border:none;cursor:pointer;"
        : "background:transparent;color:inherit;font-size:11px;font-weight:600;padding:6px 16px;border-radius:9999px;border:1px solid rgba(128,128,128,0.3);cursor:pointer;";

    string RankStyle(int r) => r switch
    {
        1 => "background:#f59e0b;color:#000;",
        2 => "background:#9ca3af;color:#000;",
        3 => "background:#b45309;color:#fff;",
        _ => Theme.IsDark
            ? "background:rgba(27,19,190,0.15);color:#6baed6;"
            : "background:rgba(65,159,217,0.12);color:#0e6fa8;"
    };

    async void Refresh() => await InvokeAsync(StateHasChanged);
    public void Dispose() { _autoTimer?.Dispose(); Theme.OnChange -= Refresh; }
}
