        {
            <div class="cf-bg"
                 style="background-image: url('@(active.CoverImageUrl ?? $"https://picsum.photos/seed/{active.Slug}/1200/500")');">
            </div>
        }

        <div class="cf-stage">
            @for (int i = 0; i < items.Count; i++)
            {
                int idx = i;
                var c = items[idx];
                int off = CircularOffset(idx, _activeIndex, items.Count);
                bool isCenter = off == 0;
                <div class="cf-card @(isCenter ? "cf-center" : "")" data-ao="@Math.Abs(off)" style="@CardStyle(off)" @onclick="@(() => CardClick(idx))">
