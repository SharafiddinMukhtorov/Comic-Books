        .trending-card { border-radius: 10px; }
        .trending-card img {
            aspect-ratio: 3/4;          /* ref: 172 × 229.33 = aynan 3∶4 */
        }
        .trending-info { padding: 8px 10px 10px; }
        .trending-info > div:first-child {
            font-size: 13px !important; /* ref: span 13px bold white */
            line-height: 1.4 !important;
            font-weight: 700 !important;
        }
        .trending-info > div:nth-child(2) {
            font-size: 11px !important; /* ref: span 12px #999 */
        }
        .trending-info .tc-stars { margin-top: 4px; }

        /* ── SO'NGGI YANGILANISHLAR (Latest Updates) ───────────── */
        /* ref: rasm col + 232px content col, qator py-2.5 px-2    */
        .latest-grid { grid-template-columns: 1fr; gap: 0; }
