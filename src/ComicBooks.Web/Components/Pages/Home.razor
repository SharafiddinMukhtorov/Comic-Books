@page "/"
@inject IMediator Mediator
@inject NavigationManager Nav
@inject ThemeService Theme
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Manga Dunyo - Manhwa, Manga o'qing</PageTitle>

<style>
    /* ════════ Carousel (Asura uslubi — chiziqli list, faqat markaz katta) ════════ */
    .cf-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: #0f1117;   /* sahifa foni bilan bir xil — chetlarda chiziq/tasma bo'lmasin */
    }
    .cf-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: blur(42px) saturate(1.2);
        transform: scale(1.18);
        transition: background-image 0.6s ease;
        z-index: 0;
    }
    .cf-bg::after {
        content: '';
        position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 0%, transparent 60%, rgba(15,17,23,0.55) 88%, #0f1117 100%);
    }

    /* Stage — kartalar absolyut joylashadi, aylana (loop) offset bilan.
       Bo'sh joy qolmaydi, faqat markaz kartasi kattalashadi (uniform yonlar). */
    .cf-stage {
        --cf-step: 206px;     /* qo'shni kartalar markazlari orasi (markaz margini bilan) */
        --cf-cscale: 1.25;    /* markaz kartaning kattalashuvi */
        position: relative;
        z-index: 2;
        height: 330px;
        overflow: hidden;
        margin: 18px 0 18px;
    }
    .cf-card {
        position: absolute;
        left: 50%; top: 50%;
        width: 168px;
        height: 240px;
        border-radius: 4px;      /* qirrali burchak (oldin yumshoq edi) */
        overflow: hidden;
        cursor: pointer;
        background: #15171f;
        box-shadow: 0 14px 34px rgba(0,0,0,0.5);
        transition: transform 0.55s cubic-bezier(0.32,0.72,0.45,1), opacity 0.5s ease, box-shadow 0.4s ease;
        will-change: transform, opacity;
    }
    .cf-card img {
        width: 100%; height: 100%;
        object-fit: cover; display: block;
        transition: transform 0.4s ease;
    }
    /* Hover: rasm zoom bo'ladi */
    .cf-card:hover img { transform: scale(1.09); }
    .cf-card::after {
        content: '';
        position: absolute; inset: 0;
        background: rgba(7,9,15,0.30);
        transition: opacity 0.4s ease;
        pointer-events: none;
    }
    /* Markaz (faol) karta — kattalashuv inline transform'da (var(--cf-cscale)) */
    .cf-card.cf-center { box-shadow: 0 20px 50px rgba(0,0,0,0.66); }
    .cf-card.cf-center::after { opacity: 0; }

    .cf-rating {
        position: absolute;
        top: 9px; left: 9px;
        z-index: 4;
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(0,0,0,0.72);
        color: #FACC15;
        font-size: 12px; font-weight: 800;
        padding: 3px 8px;
        border-radius: 7px;
        backdrop-filter: blur(4px);
    }
    /* Reyting yulduzchasi — star (1).png ikonkasi, oltin rang */
    .star-ic {
        display: inline-block;
        width: 1em; height: 1em;
        flex-shrink: 0;
        background-color: #FACC15;
        -webkit-mask: url('/img/stat-star.png') center / contain no-repeat;
        mask: url('/img/stat-star.png') center / contain no-repeat;
        vertical-align: -0.13em;
    }
    .cf-card-title {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        z-index: 4;
        padding: 28px 12px 11px;
        background: linear-gradient(transparent, rgba(0,0,0,0.92));
        color: #fff;
        font-size: 13px; font-weight: 700;   /* ref: sm:text-sm font-bold */
        line-height: 1.2;                    /* leading-tight */
        text-shadow: 0 1px 6px rgba(0,0,0,0.6);
        /* Asuradek: ko'pi bilan 2 qator, ortig'i "..." bo'ladi (3 qatorga cho'zilmaydi) */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @@media (max-width: 768px) {
        .cf-stage { height: 332px; margin: 16px 0 16px; --cf-step: 208px; --cf-cscale: 1.375; }
        .cf-card { width: 160px; height: 229px; }
        .cf-card-title { font-size: 12px; padding: 26px 10px 10px; }
        .cf-rating { font-size: 11px; padding: 3px 7px; top: 7px; left: 7px; }
    }

    /* ── Hero / Carousel (eski — ishlatilmaydi) ── */
    .hero-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        background: #0f1117;
        margin: 0;
        padding: 0;
        margin-top: 0;
    }

    .hero-bg-blur {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: blur(28px) brightness(0.35) saturate(1.4);
        transform: scale(1.08);
        transition: background-image 0.6s ease;
    }

    /* ── Light mode: hero blur oq/yorug' bo'ladi ── */
    .hero-wrapper.light {
        background: #edf2fd;
    }
    .hero-wrapper.light .hero-bg-blur {
        filter: blur(28px) brightness(1.35) saturate(0.7);
        opacity: 0.45;
    }
    .hero-wrapper.light .hero-title {
        color: #252D55;
        text-shadow: none;
    }
    .hero-wrapper.light .hero-genre-tag {
        background: rgba(0,0,0,0.07);
        color: rgba(0,0,0,0.72);
    }
    .hero-wrapper.light .hero-views {
        color: rgba(0,0,0,0.45);
    }
    .hero-wrapper.light .hero-dot {
        background: rgba(0,0,0,0.18);
    }
    .hero-wrapper.light .hero-dot.active {
        background: #60a5fa;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 420px;
        padding: 48px 60px;
        gap: 32px;
    }

    .hero-left {
        flex: 1;
        max-width: 560px;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(245,158,11,0.18);
        border: 1px solid rgba(245,158,11,0.4);
        color: #f59e0b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 5px 14px;
        border-radius: 999px;
        margin-bottom: 16px;
        text-transform: uppercase;
    }

    .hero-title {
        font-size: clamp(26px, 3.5vw, 42px);
        font-weight: 900;
        color: #fff;
        line-height: 1.15;
        margin: 0 0 14px;
        text-shadow: 0 2px 12px rgba(0,0,0,0.5);
    }

    .hero-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .hero-genre-tag {
        background: rgba(20,40,100,0.55);
        border: 1px solid rgba(59,130,246,0.50);
        color: #60a5fa;
        border-radius: 8px;
        padding: 5px 13px;
        font-size: 12px;
        font-weight: 600;
    }

    .hero-rating {
        color: #f59e0b;
        font-weight: 800;
        font-size: 14px;
    }

    .hero-views {
        color: rgba(255,255,255,0.5);
        font-size: 12px;
    }

    .hero-read-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        /* Kirish tugmasi bilan bir xil rang */
        background: linear-gradient(90deg, #1C72F3 0%, #1392EC 100%);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 22px;
        font-size: 13.5px;
        font-weight: 800;
        cursor: pointer;
        text-decoration: none;
        /* yorug'lik (glow) kamaytirildi — bo'rtib turmasin */
        box-shadow: 0 2px 8px rgba(28,114,243,0.28);
        transition: filter 0.2s, box-shadow 0.2s;
    }

    .hero-read-btn:hover {
        filter: brightness(1.08);
        box-shadow: 0 4px 14px rgba(28,114,243,0.4);
        color: #fff;
    }

    .hero-right {
        flex-shrink: 0;
        position: relative;
    }

    /* Ko'k gradient border wrapper — sayt ranglariga mos */
    .hero-cover-wrap {
        position: relative;
        width: 250px;
        height: 355px;
        border-radius: 12px;
        padding: 2.5px;
        background: linear-gradient(135deg, #60a5fa, #3b82f6 60%, #0f1117);
        box-shadow: 0 0 32px rgba(96,165,250,0.5), 0 0 64px rgba(59,130,246,0.25);
    }
    .hero-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
        display: block;
        background: #000;
    }

    /* Cover overlay (view count, rating ichida) */
    .hero-cover-overlay {
        position: absolute;
        bottom: 6px;
        left: 6px;
        right: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 10px;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(6px);
        border-radius: 8px;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        z-index: 2;
    }
    .hero-cover-overlay .hco-rating { color: #f59e0b; }
    .hero-cover-overlay .hco-views  { color: rgba(255,255,255,0.95); display: inline-flex; align-items: center; gap: 3px; }

    .hero-cover-year {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0,0,0,0.7);
        color: rgba(255,255,255,0.7);
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 6px;
        white-space: nowrap;
    }

    /* Dots */
    .hero-dots {
        position: absolute;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 5;
    }

    .hero-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(255,255,255,0.35);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.25s;
    }

    .hero-dot.active {
        background: #fff;
        width: 22px;
        border-radius: 4px;
    }

    /* ── Section header ── */
    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .section-title {
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-title::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 20px;
        background: linear-gradient(180deg, #60a5fa, #3b82f6);
        border-radius: 2px;
    }
    .hb-light .section-title::before {
        background: linear-gradient(180deg, #5b8cff, #2D6BFF);
    }

    /* Trending — 4-col grid */
    .trending-scroll {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    @@media (max-width: 1100px) and (min-width: 769px) {
        .trending-scroll { grid-template-columns: repeat(3, 1fr); }
    }

    .trending-card {
        border-radius: 10px;
        overflow: hidden;
        background: #17181e;
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 6px 20px rgba(0,0,0,0.22);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
        position: relative;
    }

    .trending-card:hover { transform: translateY(-6px); box-shadow: 0 14px 36px rgba(0,0,0,0.34); }

    /* ── Reytinglar segmented control (Weekly/Monthly/All Time uslubi) ── */
    .rt-seg {
        display: inline-flex;
        background: rgba(255,255,255,0.06);
        border-radius: 10px;
        padding: 3px;
        gap: 2px;
    }
    .hb-light .rt-seg { background: #eef1f8; }
    .rt-seg-btn {
        border: none;
        background: transparent;
        color: var(--mud-palette-text-secondary);
        font-size: 11px; font-weight: 700;
        padding: 6px 13px;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s, color 0.15s;
    }
    .rt-seg-btn:hover:not(.active) { color: var(--mud-palette-text-primary); }
    .rt-seg-btn.active { background: #3b82f6; color: #fff; }
    .hb-light .rt-seg-btn.active { background: #2D6BFF; color: #fff; }

    /* ── Oq rejim: har bir bo'limni alohida kartochka (shape) sifatida ajratish ──
       Dark rejimda hech narsa qo'shilmaydi — bo'limlar hozirgidek qoladi. */
    .hb-light .home-card {
        background: #ffffff;
        border: 1px solid #e3e8f5;
        box-shadow: 0 1px 3px rgba(16,24,64,0.05), 0 8px 24px rgba(16,24,64,0.05);
        border-radius: 14px;
        padding: 18px 18px 22px;
    }
    /* Mashhur kartochkalar oq rejimda yumshoqroq soya bilan */
    .hb-light .trending-card {
        box-shadow: 0 1px 4px rgba(16,24,64,0.06);
    }
    .hb-light .trending-card:hover {
        box-shadow: 0 10px 28px rgba(16,24,64,0.12);
    }

    .trending-card img {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        display: block;
    }

    .trending-card-rating {
        position: absolute;
        bottom: 8px;
        left: 8px;
        background: rgba(0,0,0,0.78);
        color: #FACC15;
        font-size: 12px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 7px;
        backdrop-filter: blur(4px);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .trending-card-views {
        position: absolute;
        bottom: 8px;
        right: 8px;
        background: rgba(0,0,0,0.78);
        color: rgba(255,255,255,0.9);
        font-size: 12px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 7px;
        backdrop-filter: blur(4px);
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .trending-card-img-wrap { position: relative; }

    .trending-info {
        padding: 10px 10px 12px;
        background: #17181e;
    }
    /* Oq rejimda kartochkalar oq qoladi */
    .hb-light .trending-card,
    .hb-light .trending-info { background: #ffffff; }

    .trending-info .tc-stars {
        display: flex;
        align-items: center;
        gap: 1px;
        margin-top: 4px;
    }
    .trending-info .tc-star {
        width: 11px; height: 11px;
        display: inline-block;
        background-color: #FACC15;
        -webkit-mask: url('/img/stat-star.png') center / contain no-repeat;
        mask: url('/img/stat-star.png') center / contain no-repeat;
    }
    .trending-info .tc-star.empty{ background-color: rgba(128,128,128,0.35); }

    /* Rating pagination */
    /* Rating sidebar card — oxirgi item border yo'q */
    .ratings-sidebar a:last-of-type > div {
        border-bottom: none !important;
    }

    .rating-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,0.07);
    }
    .rp-btn {
        min-width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid rgba(128,128,128,0.25);
        background: transparent;
        color: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        padding: 0 8px;
        transition: all 0.15s;
    }
    .rp-btn:hover:not(:disabled):not(.active) { background: rgba(59,130,246,0.12); border-color: rgba(59,130,246,0.4); }
    .rp-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .rp-btn.active { background: #3b82f6 !important; color: #fff !important; border-color: #3b82f6 !important; }
    .hb-light .rating-pagination { border-top-color: #e4e9f7; }
    .hb-light .rp-btn { border-color: #e4e9f7; color: #252D55; }
    .hb-light .rp-btn:hover:not(:disabled):not(.active) { background: rgba(45,107,255,0.08); border-color: rgba(45,107,255,0.35); }

    .rating-item {
        display: flex;
        gap: 10px;
        align-items: center;
        padding: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s;
    }
    .rating-item:hover { background: rgba(59,130,246,0.06); }
    .hb-light .rating-item { border-bottom-color: #e4e9f7; }
    .hb-light .rating-item:hover { background: rgba(45,107,255,0.04); }

    /* Grid item overflow fix */
    .latest-updates-grid > a { min-width: 0; overflow: hidden; display: block; }
    .lr-content { flex: 1; min-width: 0; overflow: hidden; }
    .lr-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }

    .latest-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 11px;
        overflow: hidden;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        cursor: pointer;
        transition: background 0.18s, border-color 0.18s, box-shadow 0.18s;
        position: relative;
    }

    .latest-row:hover {
        background: rgba(59,130,246,0.08);
        border-color: rgba(59,130,246,0.3);
        box-shadow: inset 3px 0 0 #3b82f6;
    }
    .hb-light .latest-row {
        background: #ffffff;
        border-color: #e3e8f5;
        box-shadow: 0 1px 4px rgba(16,24,64,0.06);
    }
    .hb-light .latest-row:hover {
        background: #eef3fe;
        border-color: rgba(45,107,255,0.28);
        box-shadow: inset 3px 0 0 #2D6BFF;
    }

    /* Latest Updates — genre va status badgelar */
    .lr-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 7px; }

    /* ── Dark mode badges ── */
    .lr-badge-genre {
        background: rgba(20,40,100,0.55);
        border: 1px solid rgba(59,130,246,0.42);
        color: #60a5fa;
        border-radius: 5px; padding: 2px 7px;
        font-size: 10.5px; font-weight: 700; white-space: nowrap;
    }
    .lr-badge-ongoing {
        background: rgba(34,197,94,0.15);
        border: 1px solid rgba(34,197,94,0.38);
        color: #22c55e;
        border-radius: 5px; padding: 2px 7px;
        font-size: 10.5px; font-weight: 700; white-space: nowrap;
    }
    .lr-badge-complete {
        background: rgba(59,130,246,0.15);
        border: 1px solid rgba(59,130,246,0.38);
        color: #60a5fa;
        border-radius: 5px; padding: 2px 7px;
        font-size: 10.5px; font-weight: 700; white-space: nowrap;
    }
    .lr-badge-hiatus {
        background: rgba(245,158,11,0.15);
        border: 1px solid rgba(245,158,11,0.38);
        color: #f59e0b;
        border-radius: 5px; padding: 2px 7px;
        font-size: 10.5px; font-weight: 700; white-space: nowrap;
    }

    /* Pinned glow — accent left-border glow */
    .latest-row.pinned-glow {
        box-shadow: inset 3px 0 0 #3b82f6;
        background: rgba(59,130,246,0.05);
    }

    /* Chapter badge (Bob X) */
    .lr-chap-badge {
        display: inline-block;
        font-size: 12px;
        font-weight: 500;
        color: #60a5fa;
    }
    /* So'nggi yangilanish: qulflangan (premium) bob belgisi */
    .lr-lock {
        width: 11px; height: 12px;
        display: inline-block;
        vertical-align: -1px;
        margin-right: 4px;
        background-color: #f59e0b;
        -webkit-mask: url('/img/padlock.png') center / contain no-repeat;
        mask: url('/img/padlock.png') center / contain no-repeat;
    }
    .lr-chap-time {
        font-size: 11px;
        opacity: 0.38;
    }

    /* ── Light mode badge overrides (.lt-mode prefix) ── */
    .lt-mode .lr-badge-genre {
        background: rgba(45,107,255,0.09);
        border-color: rgba(45,107,255,0.35);
        color: #2D6BFF;
    }
    .lt-mode .lr-badge-ongoing {
        background: rgba(22,163,74,0.09);
        border-color: rgba(22,163,74,0.35);
        color: #16a34a;
    }
    .lt-mode .lr-badge-complete {
        background: rgba(45,107,255,0.09);
        border-color: rgba(45,107,255,0.35);
        color: #2D6BFF;
    }
    .lt-mode .lr-badge-hiatus {
        background: rgba(217,119,6,0.09);
        border-color: rgba(217,119,6,0.35);
        color: #d97706;
    }

    /* ── Latest grid (desktop: 2-col, mobile: 1-col) ── */
    .latest-grid {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 32px;
    }

    @@media (max-width: 768px) {
        /* Hero */
        .hero-content {
            padding: 14px 16px 24px;
            min-height: 0;
            align-items: flex-start;
            gap: 14px;
        }
        .hero-badge { margin-bottom: 8px !important; }
        /* MudAppBar mobileda 56px, MudMainContent padding-top 64px →
           8px bo'shliq navbar ostida qora chiziq sifatida ko'rinadi.
           Shu bo'shliqni yopish uchun hero -8px tepaga ko'tariladi. */
        .hero-wrapper { min-height: auto; margin-top: 0; }
        .hero-right { flex-shrink: 0; }
        /* Rasm kattaroq — birinchi ko'zga tashlansin */
        .hero-cover-wrap { width: 172px; height: 246px; padding: 2px; }
        /* Matn va tugmalar kichikroq */
        .hero-title   { font-size: 17px; }
        .hero-badge   { font-size: 10px; padding: 3px 9px; }
        .hero-read-btn { padding: 8px 16px; font-size: 12.5px; }
        .hero-meta    { gap: 8px; margin-bottom: 14px; }

        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
        /* TELEFON: pixel-perfect (reference o'lchamlar asosida)   */
        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

        /* Body: 16px horizontal padding; pastki bo'sh joy kamaytirildi */
        .home-body { padding: 18px 16px 28px !important; }

        /* Oq rejim kartochkalari mobilda ixchamroq padding */
        .hb-light .home-card { padding: 14px 12px 16px; border-radius: 12px; }

        /* Section sarlavhalar: text-lg = 18px, font-medium (ref: h2 368×28) */
        .section-title { font-size: 18px; font-weight: 500; }

        /* ── MASHHUR (Trending Today) ─────────────────────────── */
        /* ref: section 400px, 2-ustun, rasm 172×229 px → nisbat 3/4 */
