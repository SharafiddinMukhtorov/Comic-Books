@page "/admin-login"
@layout MinimalLayout
@inject NavigationManager Nav

<PageTitle>Admin Login – Manga Dunyo</PageTitle>

<div class="adm-bg">
    <div class="adm-card">
        <div class="adm-logo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#419fd9" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
        </div>
        <h1>ADMIN PANEL</h1>
        <p class="adm-sub">Manga Dunyo boshqaruv paneli</p>

        @if (_err != null)
        {
            <div class="adm-error">@_err</div>
        }

        <form method="post" action="/auth/admin-login">
            <label>Login</label>
            <input type="text" name="username" required autocomplete="username" />

            <label>Parol</label>
            <input type="password" name="password" required autocomplete="current-password" />

            <button type="submit">🔐 Kirish</button>
        </form>

        <a href="/" class="adm-back">← Bosh sahifaga qaytish</a>
    </div>
</div>

<style>
    .adm-bg {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(ellipse at top, rgba(65,159,217,0.18) 0%, transparent 50%),
            radial-gradient(ellipse at bottom, rgba(3,0,130,0.25) 0%, transparent 50%),
            #0a0a14;
        padding: 24px;
    }
    .adm-card {
        background: rgba(15,15,28,0.88);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(65,159,217,0.18);
        border-radius: 20px;
        padding: 32px 28px 24px;
        width: 100%;
        max-width: 380px;
        text-align: center;
        box-shadow: 0 24px 64px rgba(0,0,0,0.6);
    }
    .adm-logo {
        background: linear-gradient(135deg, rgba(65,159,217,0.22), rgba(27,19,190,0.18));
        border-radius: 16px;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border: 1px solid rgba(65,159,217,0.35);
    }
    h1 {
        font-size: 1.3rem;
        font-weight: 900;
        color: #5b9fd9;
        letter-spacing: 1px;
        margin: 0 0 8px;
    }
    .adm-sub {
        color: rgba(255,255,255,0.5);
        font-size: 0.8rem;
        margin: 0 0 24px;
    }
    label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        opacity: 0.7;
        margin: 14px 0 5px;
        text-align: left;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    input {
        width: 100%;
        padding: 12px 14px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: border-color 0.15s;
    }
    input:focus { border-color: #419fd9; }
    button[type=submit] {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #419fd9, #1b13be);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-weight: 800;
        font-size: 14px;
        cursor: pointer;
        margin-top: 22px;
        box-shadow: 0 6px 20px rgba(27,19,190,0.5);
    }
    button[type=submit]:hover { filter: brightness(1.1); }
    .adm-back {
        display: inline-block;
        margin-top: 16px;
        color: rgba(255,255,255,0.4);
        font-size: 12px;
        text-decoration: none;
    }
    .adm-error {
        background: rgba(239,68,68,0.13);
        border: 1px solid rgba(239,68,68,0.32);
        color: #fca5a5;
        padding: 9px 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }
</style>

@code {
    string? _err;

    protected override void OnInitialized()
    {
        var qs = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (qs.TryGetValue("err", out var e))
            _err = e == "invalid" ? "❌ Login yoki parol noto'g'ri" : "Xatolik";
    }
}
