            else
            {
                <div style="background:rgba(96,165,250,0.08);border:1px solid rgba(96,165,250,0.2);
                            border-radius:8px;padding:14px;margin-bottom:14px;text-align:center;font-size:13px;">
                    <span class="lock-ic-amber"></span> Izoh qoldirish uchun
                    <a href="/login" style="color:#60a5fa;font-weight:700;">tizimga kiring</a>
