@page "/comic/{Slug}"
@inject IMediator Mediator
@inject NavigationManager Nav
@inject BookmarkService BookmarkSvc
@inject SessionService SessionSvc
@inject ThemeService Theme
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@using ComicBooks.Application.Features.Comics.Commands
@using ComicBooks.Application.Features.Comments.Queries
@using ComicBooks.Application.Features.Comments.Commands
@implements IDisposable

<PageTitle>@(_comic?.Title ?? "Comic") - Manga Dunyo</PageTitle>

<style>
    .dr {
        --acc:        #1b13be;
        --acc2:       #419fd9;
        --acc-light:  rgba(27,19,190,0.12);
        --acc-border: rgba(27,19,190,0.35);
        --panel-bg:   rgba(255,255,255,0.04);
        --panel-brd:  rgba(255,255,255,0.07);
        --ch-hover:   rgba(27,19,190,0.1);
        --lbl:        rgba(255,255,255,0.42);
        --val:        rgba(255,255,255,0.88);
        --tag-bg:     rgba(255,255,255,0.06);
        --tag-brd:    rgba(255,255,255,0.14);
        --tag-col:    rgba(255,255,255,0.85);
        --div:        rgba(255,255,255,0.07);
        position: relative;
        overflow: hidden;
        background: #0a0a14;
    }
    .dr.light {
        --acc:        #419fd9;
        --acc2:       #0e6fa8;
        --acc-light:  rgba(65,159,217,0.10);
        --acc-border: rgba(65,159,217,0.40);
        --panel-bg:   rgba(255,255,255,0.82);
        --panel-brd:  rgba(0,0,0,0.08);
        --ch-hover:   rgba(65,159,217,0.08);
        --lbl:        rgba(30,30,60,0.45);
        --val:        #1a1a2e;
        --tag-bg:     rgba(0,0,0,0.05);
        --tag-brd:    rgba(0,0,0,0.14);
        --tag-col:    #1a1a2e;
        --div:        rgba(0,0,0,0.07);
        background: #dde8f0;
    }

    /* ── Blurred banner background ── */
    .dr-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center top;
        filter: blur(28px) brightness(0.38) saturate(1.5);
        transform: scale(1.08);
        z-index: 0;
        min-height: 360px;
    }
    .dr.light .dr-bg {
        filter: blur(28px) brightness(0.95) saturate(1.2);
        opacity: 0.5;
    }

    .dr-bg-grad {
        position: absolute;
        inset: 0;
        z-index: 1;
        min-height: 360px;
        background: linear-gradient(
            to bottom,
            rgba(8,8,18,0.35) 0%,
            rgba(8,8,18,0.55) 50%,
            var(--mud-palette-background) 100%
        );
    }
    .dr.light .dr-bg-grad {
        background: linear-gradient(
            to bottom,
            rgba(221,232,240,0.55) 0%,
            rgba(221,232,240,0.85) 50%,
            #dde8f0 100%
        );
    }

    /* ── Outer wrap ── */
    .dr-wrap {
        position: relative;
        z-index: 2;
        max-width: 1100px;
        margin: 0 auto;
        padding: 36px 20px 80px;
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    /* ── LEFT PANEL ── */
    .dr-left {
        flex: 0 0 264px;
        background: var(--panel-bg);
        border: 1px solid var(--panel-brd);
        border-radius: 12px;
        overflow: hidden;
        position: sticky;
        top: 80px;
    }

    .dr-cover {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
    }

    .dr-panel-body { padding: 14px 14px 16px; }

    /* Rating button */
    .dr-rate-btn {
        width: 100%;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1.5px solid rgba(245,158,11,0.50);
        background: rgba(245,158,11,0.06);
        border-radius: 8px;
        color: #f59e0b;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        margin-bottom: 14px;
        transition: background 0.2s;
    }
    .dr-rate-btn:hover { background: rgba(245,158,11,0.13); }

    /* Stats */
    .dr-stats {
        display: flex;
        border: 1px solid var(--panel-brd);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 14px;
    }
    .dr-stat {
        flex: 1;
        padding: 9px 4px;
        text-align: center;
        border-right: 1px solid var(--panel-brd);
    }
    .dr-stat:last-child { border-right: none; }
    .dr-stat-val {
        font-size: 14px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        margin-bottom: 2px;
        white-space: nowrap;
    }
    .dr-stat-lbl {
        font-size: 9.5px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
        color: var(--lbl);
    }

    .dr-div { height: 1px; background: var(--div); margin: 12px 0; }

    /* Status / Type */
    .dr-st-row { display: flex; gap: 22px; }
    .dr-meta-item { display: flex; flex-direction: column; gap: 3px; }
    .dr-meta-lbl {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
        color: var(--lbl);
    }
    .dr-meta-val {
        font-size: 13px;
        font-weight: 700;
        color: var(--acc);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .dr-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--acc);
        display: inline-block;
        flex-shrink: 0;
    }

    /* Author / Artist rows */
    .dr-person-row {
        display: flex;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--div);
        gap: 8px;
    }
    .dr-person-row:last-of-type { border-bottom: none; }
    .dr-person-icon { font-size: 13px; width: 22px; flex-shrink: 0; color: var(--lbl); }
    .dr-person-lbl  { font-size: 11px; color: var(--lbl); font-weight: 600; width: 52px; flex-shrink: 0; }
    .dr-person-val  { font-size: 13px; font-weight: 700; color: var(--val); }

    /* Genre tags */
    .dr-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .dr-tag {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        background: var(--tag-bg);
        border: 1px solid var(--tag-brd);
        color: var(--tag-col);
        text-decoration: none;
        transition: background 0.15s;
    }
    .dr-tag:hover { background: var(--acc-light); }

    /* ── RIGHT COLUMN ── */
    .dr-right { flex: 1; min-width: 0; }

    .dr-title {
        font-size: clamp(20px, 2.5vw, 30px);
        font-weight: 900;
        margin: 0 0 10px;
        line-height: 1.2;
        color: var(--val);
    }

    .dr-rank-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        flex-wrap: wrap;
        min-height: 24px;
    }
    .dr-rank-badge {
        background: #f59e0b;
        color: #000;
        font-size: 11px;
        font-weight: 900;
        padding: 3px 10px;
        border-radius: 4px;
        white-space: nowrap;
    }
    .dr-alt {
        font-size: 12px;
        color: var(--lbl);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .dr-desc {
        font-size: 14px;
        line-height: 1.78;
        color: var(--val);
        opacity: 0.82;
        margin-bottom: 4px;
    }
    .dr-desc.clamped {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .dr-show-more {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--acc);
        cursor: pointer;
        margin-bottom: 24px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: none;
        background: none;
        padding: 0;
    }

    /* Action buttons */
    .dr-actions { display: flex; gap: 10px; margin-bottom: 28px; }

    .dr-btn-bm {
        flex: 1.3;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 10px;
        font-size: 14.5px;
        font-weight: 800;
        cursor: pointer;
        border: none;
        background: var(--acc);
        color: #fff;
        transition: opacity 0.2s;
        white-space: nowrap;
    }
    .dr-btn-bm:hover { opacity: 0.88; }
    .dr-btn-bm.saved {
        background: var(--acc-light);
        color: var(--acc);
        border: 1.5px solid var(--acc-border);
    }

    .dr-btn-ch {
        flex: 1;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: 1.5px solid var(--panel-brd);
        background: var(--panel-bg);
        color: inherit;
        transition: border-color 0.2s, background 0.2s;
        white-space: nowrap;
    }
    .dr-btn-ch:hover { border-color: var(--acc); background: var(--acc-light); color: inherit; }

    /* Chapter header */
    .ch-hdr {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }
    .ch-count { font-size: 1rem; font-weight: 900; }
    .ch-sort {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid var(--panel-brd);
        background: var(--panel-bg);
        cursor: pointer;
        color: inherit;
    }

    /* Search */
    .ch-srch-wrap { position: relative; margin-bottom: 12px; }
    .ch-srch-inp {
        width: 100%;
        height: 46px;
        padding: 0 44px 0 16px;
        border-radius: 10px;
        background: var(--panel-bg);
        border: 1px solid var(--panel-brd);
        color: inherit;
        font-size: 14px;
        outline: none;
        font-family: inherit;
    }
    .ch-srch-ico {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.32;
        pointer-events: none;
    }

    /* Chapter list */
    .ch-list {
        border: 1px solid var(--panel-brd);
        border-radius: 12px;
        overflow: hidden;
        max-height: 560px;
        overflow-y: auto;
    }
    .ch-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        border-bottom: 1px solid var(--div);
        text-decoration: none;
        color: inherit;
        transition: background 0.15s;
        position: relative;
    }
    .ch-row:last-child { border-bottom: none; }
    .ch-row:hover { background: var(--ch-hover); }

    /* Locked chapter: nozik gradient highlight chapdan */
    .ch-row.locked {
        background: linear-gradient(90deg,
            rgba(245,158,11,0.08) 0%,
            rgba(245,158,11,0.02) 35%,
            transparent 60%);
    }
    .ch-row.locked:hover {
        background: linear-gradient(90deg,
            rgba(245,158,11,0.14) 0%,
            rgba(245,158,11,0.04) 35%,
            var(--ch-hover) 100%);
    }

    .ch-name { font-weight: 700; font-size: 14px; }
    .ch-sub  { font-size: 12px; opacity: 0.40; margin-left: 8px; }
    .ch-lock-icon {
        font-size: 14px;
        flex-shrink: 0;
        color: #f59e0b;
        filter: drop-shadow(0 0 3px rgba(245,158,11,0.4));
    }
    .ch-coin {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        background: linear-gradient(135deg, rgba(245,158,11,0.22), rgba(245,158,11,0.12));
        color: #f59e0b;
        padding: 3px 9px;
        border-radius: 999px;
        font-weight: 800;
        margin-left: 10px;
        border: 1px solid rgba(245,158,11,0.3);
    }
    .ch-coin img { width: 13px; height: 13px; }
    .ch-date { font-size: 12px; color: var(--lbl); flex-shrink: 0; }

    /* Rating widget */
    .dr-rating-section {
        margin-top: 40px;
        padding-top: 28px;
        border-top: 1px solid var(--div);
        text-align: center;
    }
    .dr-rating-title   { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
    .dr-rating-sub     { font-size: 13px; color: var(--lbl); margin-bottom: 18px; }
    .dr-stars-row      { display: inline-flex; gap: 5px; }
    .dr-star {
        font-size: 30px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
        color: #f59e0b;
        transition: transform 0.13s;
    }
    .dr-star:hover, .dr-star.active { transform: scale(1.22); }
    .dr-rating-thanks  { font-size: 14px; font-weight: 700; color: var(--acc); }

    /* Scroll-to-top */
    .dr-scroll-top {
        position: fixed;
        bottom: 28px;
        right: 28px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--acc);
        color: #fff;
        border: none;
        font-size: 22px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.35);
        z-index: 999;
        transition: opacity 0.2s;
    }
    .dr-scroll-top:hover { opacity: 0.83; }

    @@media (max-width: 768px) {
        /* Unwrap .dr-left so its children join the parent flex directly */
        .dr-left {
            display: contents;
        }

        /* Cover: order 1 — centered at top, below appbar */
        .dr-cover {
            order: 1;
            width: 160px;
            height: auto;
            aspect-ratio: 2/3;
            border-radius: 14px;
            flex-shrink: 0;
            display: block;
            margin: 76px auto 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.65), 0 0 0 3px rgba(255,255,255,0.09);
        }

        /* Panel body: order 3 — after right column (title/desc/actions/chapters) */
        .dr-panel-body {
            order: 3;
            padding: 16px 16px 20px;
            width: 100%;
            border-top: 1px solid var(--div);
        }

        /* Right column: order 2 — title, desc, stats, actions, chapters */
        .dr-right {
            order: 2;
            padding: 0 16px 20px;
            width: 100%;
        }

        /* Stats bar — 3 equal boxes */
        .dr-stats {
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--panel-brd);
            margin-bottom: 16px;
        }
        .dr-stat       { flex: 1; padding: 10px 4px; }
        .dr-stat-val   { font-size: 15px; font-weight: 900; }
        .dr-stat-lbl   { font-size: 9px; letter-spacing: 0.3px; }

        /* Rate button — hidden on mobile (stars shown below) */
        .dr-rate-btn   { display: none; }

        /* Title */
        .dr-title      { font-size: 22px; margin-bottom: 10px; }

        /* Action buttons */
        .dr-actions    { flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
        .dr-btn-bm     { flex: 1 1 100%; height: 52px; border-radius: 14px; font-size: 15px; font-weight: 800; }
        .dr-btn-ch     { flex: 1 1 calc(50% - 4px); height: 48px; font-size: 13px; border-radius: 12px; }

        /* Chapter list */
        .ch-list       { max-height: none; }
        .ch-hdr        { margin-top: 4px; }

        /* Chapter row padding */
        .ch-row        { padding: 12px 16px; }

        /* Hide redundant rate button in panel-body */
        .dr-st-row     { gap: 16px; }

        /* Wrap becomes a column flex so order works */
        .dr-wrap {
            flex-direction: column;
            padding: 0 0 80px;
            gap: 0;
            max-width: 100%;
        }
    }
</style>

@{
    var tc = Theme.IsDark ? "" : "light";
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_comic is null)
{
    <div style="text-align:center;padding:80px;">
        <MudText Typo="Typo.h4" Class="mb-4">Comic topilmadi</MudText>
        <a href="/" style="display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 24px;
                           background:var(--acc);color:#fff;border-radius:10px;font-weight:700;text-decoration:none;">
            ← Bosh sahifa
        </a>
    </div>
}
else
{
<div class="dr @tc">
    <div class="dr-bg" style="background-image:url('@BgUrl()');"></div>
    <div class="dr-bg-grad"></div>
    <div class="dr-wrap">

        <!-- ════ LEFT PANEL ════ -->
        <div class="dr-left">
            <img class="dr-cover"
                 src="@CoverUrl()"
                 alt="@_comic.Title"
                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(_comic.Slug)/300/420'" />

            <div class="dr-panel-body">

                <!-- Rating button -->
                <button class="dr-rate-btn" @onclick="@(() => _showRating = !_showRating)">
                    ★&nbsp; Reyting
                </button>

                <div class="dr-div"></div>

                <!-- Status / Type -->
                <div class="dr-st-row">
                    <div class="dr-meta-item">
                        <div class="dr-meta-lbl">Holat</div>
                        <div class="dr-meta-val"><span class="dr-dot"></span>@_comic.Status</div>
                    </div>
                    <div class="dr-meta-item">
                        <div class="dr-meta-lbl">Turi</div>
                        <div class="dr-meta-val"><span class="dr-dot"></span>@_comic.Type</div>
                    </div>
                </div>

                <div class="dr-div"></div>

                <!-- Author / Artist -->
                @if (!string.IsNullOrEmpty(_comic.Author))
                {
                    <div class="dr-person-row">
                        <span class="dr-person-icon">✏️</span>
                        <span class="dr-person-lbl">Muallif</span>
                        <span class="dr-person-val">@_comic.Author</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_comic.Artist))
                {
                    <div class="dr-person-row">
                        <span class="dr-person-icon">🖼️</span>
                        <span class="dr-person-lbl">Rassom</span>
                        <span class="dr-person-val">@_comic.Artist</span>
                    </div>
                }

                <!-- Genre tags -->
                @if (_comic.Genres.Any())
                {
                    <div class="dr-tags">
                        @foreach (var g in _comic.Genres)
                        {
                            <a class="dr-tag" href="/comics?genre=@g">@g</a>
                        }
                    </div>
                }

            </div>
        </div>

        <!-- ════ RIGHT COLUMN ════ -->
        <div class="dr-right">

            <h1 class="dr-title">@_comic.Title</h1>

            <div class="dr-rank-row">
                @if (_comic.AverageRating >= 9.0)
                {
                    <span class="dr-rank-badge">⭐ TOP RATED</span>
                }
                @if (!string.IsNullOrEmpty(_comic.AlternativeTitles))
                {
                    <span class="dr-alt">@_comic.AlternativeTitles</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_comic.Description))
            {
                <div class="dr-desc @(!_showMore ? "clamped" : "")">@_comic.Description</div>
                <button class="dr-show-more" @onclick="@(() => _showMore = !_showMore)">
                    @(_showMore ? "Yig'ish ↑" : "Ko'proq ko'rish ↓")
                </button>
            }

            <!-- Stats: Rating | Chapters | Bookmarks -->
            <div class="dr-stats">
                <div class="dr-stat">
                    <div class="dr-stat-val" style="color:#f59e0b;">⭐ @_comic.AverageRating.ToString("F1")</div>
                    <div class="dr-stat-lbl">Reyting</div>
                </div>
                <div class="dr-stat">
                    <div class="dr-stat-val" style="color:#34d399;">📗 @_comic.ChapterCount</div>
                    <div class="dr-stat-lbl">Boblar</div>
                </div>
                <div class="dr-stat">
                    <div class="dr-stat-val" style="color:#419fd9;display:inline-flex;align-items:center;gap:6px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17 3H7a2 2 0 0 0-2 2v16l7-3 7 3V5a2 2 0 0 0-2-2z"/>
                        </svg>
                        @Fmt(_comic.BookmarkCount)
                    </div>
                    <div class="dr-stat-lbl">Saqlangan</div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="dr-actions">
                <button class="dr-btn-bm @(IsBookmarked ? "saved" : "")"
                        @onclick="ToggleBookmark">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
                         style="vertical-align:-3px;margin-right:6px;">
                        <path d="M17 3H7a2 2 0 0 0-2 2v16l7-3 7 3V5a2 2 0 0 0-2-2z"/>
                    </svg>
                    @(IsBookmarked ? "Saqlangan" : "Bookmark")
                </button>
                @if (FirstId != Guid.Empty)
                {
                    <a class="dr-btn-ch" href="/chapter/@FirstId">◉&nbsp;Birinchi bob</a>
                    <a class="dr-btn-ch" href="/chapter/@LastId">◉&nbsp;Oxirgi bob</a>
                }
                else
                {
                    <span class="dr-btn-ch" style="opacity:.4;cursor:default;">◉&nbsp;Birinchi bob</span>
                    <span class="dr-btn-ch" style="opacity:.4;cursor:default;">◉&nbsp;Oxirgi bob</span>
                }
            </div>

            <!-- Chapter header -->
            <div class="ch-hdr">
                <span class="ch-count">@_chapters.Count Boblar</span>
                <button class="ch-sort" @onclick="@(() => _desc = !_desc)">
                    ↑↓&nbsp;@(_desc ? "Yangi" : "Eski")
                </button>
            </div>

            <!-- Search -->
            <div class="ch-srch-wrap">
                <input class="ch-srch-inp"
                       @bind="_chapSearch"
                       @bind:event="oninput"
                       placeholder="Bob qidirish..." />
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="ch-srch-ico" Style="font-size:18px;" />
            </div>

            <!-- Chapter list -->
            <div class="ch-list">
                @foreach (var ch in Filtered())
                {
                    <a class="ch-row @(ch.IsLocked ? "locked" : "")" href="/chapter/@ch.Id">
                        <div style="display:flex;align-items:center;min-width:0;gap:8px;">
                            @if (ch.IsLocked)
                            {
                                <span class="ch-lock-icon">🔒</span>
                            }
                            <span class="ch-name">Bob @ch.ChapterNumber</span>
                            @if (!string.IsNullOrEmpty(ch.Title))
                            {
                                <span class="ch-sub">@ch.Title</span>
                            }
                            @if (ch.IsLocked && ch.CoinPrice > 0)
                            {
                                <span class="ch-coin">
                                    <img src="/img/coin.svg" alt="coin" />@ch.CoinPrice
                                </span>
                            }
                        </div>
                        <span class="ch-date">@FmtDate(ch.PublishedAt)</span>
                    </a>
                }
                @if (!Filtered().Any())
                {
                    <div style="padding:40px;text-align:center;opacity:.4;">Bob topilmadi.</div>
                }
            </div>

            <!-- Rating section -->
            @if (_showRating)
            {
                <div class="dr-rating-section">
                    <div class="dr-rating-title">Bu manga haqida nima deb o'ylaysiz?</div>
                    <div class="dr-rating-sub">@_comic.RatingCount reaksiyalar</div>
                    @if (_ratingSubmitted)
                    {
                        <div class="dr-rating-thanks">✓ Rahmat! Baholashingiz qabul qilindi.</div>
                    }
                    else
                    {
                        <div class="dr-stars-row" style="gap:3px;">
                            @for (int i = 1; i <= 10; i++)
                            {
                                int star = i;
                                <button class="dr-star @(_hoverStar >= star || _selectedStar >= star ? "active" : "")"
                                        style="font-size:24px;"
                                        @onmouseenter="@(() => _hoverStar = star)"
                                        @onmouseleave="@(() => _hoverStar = 0)"
                                        @onclick="@(() => SubmitRating(star))">
                                    @(_hoverStar >= star || _selectedStar >= star ? "★" : "☆")
                                </button>
                            }
                        </div>
                        @if (_hoverStar > 0)
                        {
                            <div style="font-size:13px;color:var(--lbl);margin-top:6px;">@_hoverStar / 10</div>
                        }
                    }
                </div>
            }

        </div>
    </div>

    <!-- ════ COMMENTS SECTION ════ -->
    <div style="max-width:1100px;margin:32px auto 90px;padding:0 20px;position:relative;z-index:2;">
        <div style="background:var(--mud-palette-surface);border:1px solid rgba(128,128,128,0.14);
                    border-radius:14px;padding:22px 20px;">
            <h3 style="font-size:1rem;font-weight:900;margin:0 0 16px;display:flex;align-items:center;gap:8px;">
                💬 Komentariyalar
                <span style="font-size:13px;opacity:0.5;font-weight:600;">(@_comicComments.Count)</span>
            </h3>

            @if (_currentUserId != Guid.Empty)
            {
                <div style="background:rgba(128,128,128,0.05);border:1px solid rgba(128,128,128,0.14);
                            border-radius:10px;padding:12px;margin-bottom:18px;">
                    <textarea @bind="_newComicComment" placeholder="Fikringizni yozing..."
                              maxlength="1000" rows="3"
                              style="width:100%;background:transparent;border:none;outline:none;
                                     color:inherit;font-size:14px;resize:vertical;min-height:60px;font-family:inherit;"></textarea>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;">
                        <span style="font-size:11px;opacity:0.45;">@_newComicComment.Length / 1000</span>
                        <button @onclick="@PostComicComment"
                                disabled="@(_postingComicComment || string.IsNullOrWhiteSpace(_newComicComment) || _newComicComment.Trim().Length < 2)"
                                style="background:linear-gradient(135deg,#419fd9,#1b13be);color:#fff;border:none;
                                       padding:8px 18px;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
                            @(_postingComicComment ? "⏳ Yuborilmoqda..." : "📩 Yuborish")
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div style="background:rgba(65,159,217,0.08);border:1px solid rgba(65,159,217,0.2);
                            border-radius:10px;padding:14px;margin-bottom:14px;text-align:center;font-size:13px;">
                    🔒 Komentariya qoldirish uchun
                    <a href="/login" style="color:#419fd9;font-weight:700;">tizimga kiring</a>
                </div>
            }

            @if (_comicComments.Count == 0)
            {
                <div style="text-align:center;padding:30px 16px;color:rgba(128,128,128,0.6);font-size:13px;">
                    💬 Hozircha komentariyalar yo'q.
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:14px;">
                    @foreach (var c in _comicComments)
                    {
                        <div style="display:flex;gap:10px;padding:12px;background:rgba(128,128,128,0.04);
                                    border-radius:10px;border:1px solid rgba(128,128,128,0.08);">
                            <div style="width:36px;height:36px;border-radius:50%;flex-shrink:0;
                                        background:linear-gradient(135deg,#419fd9,#1b13be);color:#fff;
                                        font-weight:800;display:flex;align-items:center;justify-content:center;
                                        overflow:hidden;">
                                @if (!string.IsNullOrEmpty(c.UserPicture))
                                {
                                    <img src="@c.UserPicture" alt="@c.UserName" style="width:100%;height:100%;object-fit:cover;" />
                                }
                                else
                                {
                                    @(c.UserName.Length > 0 ? c.UserName[0].ToString().ToUpper() : "?")
                                }
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap;">
                                    <span style="font-weight:700;font-size:13px;">@c.UserName</span>
                                    <span style="font-size:11px;opacity:0.45;">@FmtCommentTime(c.CreatedAt)</span>
                                </div>
                                <div style="font-size:13.5px;line-height:1.55;word-wrap:break-word;white-space:pre-wrap;">@c.Content</div>
                                @if (c.UserId == _currentUserId || _isAdmin)
                                {
                                    <button @onclick="@(() => DeleteComicComment(c.Id))"
                                            style="background:none;border:none;color:#ef4444;font-size:11px;cursor:pointer;padding:4px 0 0;opacity:0.6;">
                                        🗑️ O'chirish
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Scroll to top -->
    <button class="dr-scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Yuqoriga">↑</button>
</div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    ComicDto?        _comic;
    List<ChapterDto> _chapters      = new();
    bool   _loading         = true;
    bool   _desc            = true;
    bool   _showMore        = false;
    bool   _showRating      = false;
    string _chapSearch      = "";
    int    _hoverStar       = 0;
    int    _selectedStar    = 0;
    bool   _ratingSubmitted = false;

    // Comments
    List<ChapterCommentDto> _comicComments = new();
    string _newComicComment = "";
    bool   _postingComicComment = false;
    Guid   _currentUserId = Guid.Empty;
    bool   _isAdmin       = false;

    bool IsBookmarked => _comic != null && BookmarkSvc.IsBookmarked(_comic.Id);
    Guid FirstId => _chapters.OrderBy(c => c.ChapterNumber).FirstOrDefault()?.Id ?? Guid.Empty;
    Guid LastId  => _chapters.OrderByDescending(c => c.ChapterNumber).FirstOrDefault()?.Id ?? Guid.Empty;

    string CoverUrl() => !string.IsNullOrEmpty(_comic?.CoverImageUrl)
        ? _comic.CoverImageUrl
        : $"https://picsum.photos/seed/{_comic?.Slug}/300/420";

    string BgUrl() => !string.IsNullOrEmpty(_comic?.BannerImageUrl) ? _comic.BannerImageUrl
                    : !string.IsNullOrEmpty(_comic?.CoverImageUrl)  ? _comic.CoverImageUrl
                    : $"https://picsum.photos/seed/{_comic?.Slug}bg/1400/600";

    string Fmt(int v) => v >= 1_000_000 ? $"{v/1_000_000.0:F1}M"
                       : v >= 1_000     ? $"{v/1_000.0:F1}K"
                       : v.ToString();

    string FmtDate(DateTime? d)
    {
        if (d is null) return "";
        var diff = DateTime.UtcNow - d.Value;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m oldin";
        if (diff.TotalHours  < 24) return $"{(int)diff.TotalHours}s oldin";
        if (diff.TotalDays   < 7)  return $"{(int)diff.TotalDays} kun oldin";
        if (diff.TotalDays   < 30) return $"{(int)(diff.TotalDays/7)} hafta oldin";
        return d.Value.ToString("MMM d, yyyy");
    }

    List<ChapterDto> Filtered()
    {
        var list = _desc
            ? _chapters.OrderByDescending(c => c.ChapterNumber).ToList()
            : _chapters.OrderBy(c => c.ChapterNumber).ToList();
        if (!string.IsNullOrWhiteSpace(_chapSearch))
            list = list.Where(c => c.ChapterNumber.ToString().Contains(_chapSearch)
                               || (c.Title ?? "").Contains(_chapSearch, StringComparison.OrdinalIgnoreCase))
                       .ToList();
        return list;
    }

    protected override async Task OnInitializedAsync()
    {
        Theme.OnChange += Refresh;

        var st = await AuthState.GetAuthenticationStateAsync();
        if (st.User.Identity?.IsAuthenticated == true
            && Guid.TryParse(st.User.FindFirst("app_user_id")?.Value, out var uid))
        {
            _currentUserId = uid;
            _isAdmin = st.User.FindFirst("app_is_admin")?.Value == "true";
        }

        _comic = await Mediator.Send(new GetComicBySlugQuery(Slug));
        if (_comic != null)
        {
            _chapters = await Mediator.Send(new GetChaptersByComicQuery(_comic.Id));
            _ = LoadCommentsAsync();
        }
        _loading = false;
    }

    async Task LoadCommentsAsync()
    {
        if (_comic is null) return;
        try
        {
            _comicComments = await Mediator.Send(new GetComicCommentsQuery(_comic.Id));
            await InvokeAsync(StateHasChanged);
        }
        catch { _comicComments = new(); }
    }

    async Task PostComicComment()
    {
        if (_comic is null || _currentUserId == Guid.Empty
            || string.IsNullOrWhiteSpace(_newComicComment)
            || _newComicComment.Trim().Length < 2) return;
        _postingComicComment = true;
        try
        {
            await Mediator.Send(new AddComicCommentCommand(_comic.Id, _currentUserId, _newComicComment.Trim()));
            _newComicComment = "";
            await LoadCommentsAsync();
            Snackbar.Add("✅ Komentariya qo'shildi", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"❌ {ex.Message}", Severity.Error); }
        _postingComicComment = false;
    }

    async Task DeleteComicComment(Guid id)
    {
        var ok = await Mediator.Send(new DeleteCommentCommand(id, _currentUserId, _isAdmin));
        if (ok)
        {
            _comicComments.RemoveAll(c => c.Id == id);
            await InvokeAsync(StateHasChanged);
        }
    }

    static string FmtCommentTime(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalMinutes < 1)  return "hozirgina";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays} kun oldin";
        if (diff.TotalDays    < 30) return $"{(int)(diff.TotalDays / 7)} hafta oldin";
        return d.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _comic is null) return;

        await BookmarkSvc.EnsureLoadedAsync();

        var sessionId = await SessionSvc.GetSessionIdAsync();
        var counted   = await Mediator.Send(new TrackComicViewCommand(sessionId, _comic.Id));
        if (counted) _comic.ViewCount++;

        await InvokeAsync(StateHasChanged);
    }

    async Task ToggleBookmark()
    {
        if (_comic is null) return;
        await BookmarkSvc.ToggleAsync(_comic.Id);
        if (BookmarkSvc.IsBookmarked(_comic.Id))
            _comic.BookmarkCount++;
        else if (_comic.BookmarkCount > 0)
            _comic.BookmarkCount--;
        await InvokeAsync(StateHasChanged);
    }

    async Task SubmitRating(int stars)
    {
        if (_ratingSubmitted || _comic is null) return;
        _selectedStar    = stars;
        _ratingSubmitted = true;
        var newAvg = await Mediator.Send(new RateComicCommand(_comic.Id, stars));
        _comic.AverageRating = newAvg;
        _comic.RatingCount++;
        await InvokeAsync(StateHasChanged);
    }

    async void Refresh() => await InvokeAsync(StateHasChanged);
    public void Dispose() => Theme.OnChange -= Refresh;
}
