@page "/comic/{Slug}"
@inject IMediator Mediator
@inject NavigationManager Nav
@inject BookmarkService BookmarkSvc
@inject SessionService SessionSvc
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using ComicBooks.Application.Features.Comics.Commands
@using ComicBooks.Application.Features.Comments.Queries
@using ComicBooks.Application.Features.Comments.Commands

<PageTitle>@(_comic?.Title ?? "Comic") - Manga Dunyo</PageTitle>

<style>
    .dr {
        --acc:        #3b82f6;
        --acc2:       #60a5fa;
        --acc-light:  rgba(59,130,246,0.12);
        --acc-border: rgba(59,130,246,0.35);
        --panel-bg:   rgba(255,255,255,0.04);
        --panel-brd:  rgba(255,255,255,0.07);
        --ch-hover:   rgba(59,130,246,0.1);
        --lbl:        rgba(255,255,255,0.42);
        --val:        rgba(255,255,255,0.92);
        --tag-bg:     rgba(255,255,255,0.06);
        --tag-brd:    rgba(255,255,255,0.14);
        --tag-col:    rgba(255,255,255,0.85);
        --div:        rgba(255,255,255,0.07);
        position: relative;
        overflow: hidden;
        background: #101014;
    }
    /* ── Subtle blur banner (faqat tepa qism) ── */
    .dr-bg {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 500px;
        background-size: cover;
        background-position: center top;
        filter: blur(12px) brightness(0.5) saturate(1.2);
        transform: scale(1.05);
        z-index: 0;
        opacity: 0.85;
    }
    /* Gradient: dr-bg (500px) dan balandroq → cheti ko'rinmaydi */
    .dr-bg-grad {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 560px;
        z-index: 1;
        background: linear-gradient(
            to bottom,
            rgba(16,16,20,0.30) 0%,
            rgba(16,16,20,0.65) 42%,
            rgba(16,16,20,0.95) 58%,
            #101014             66%
        );
    }
    /* ── Outer wrap ── */
    .dr-wrap {
        position: relative;
        z-index: 2;
        max-width: 1100px;
        margin: 0 auto;
        padding: 36px 20px 80px;
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    /* ── LEFT PANEL ── */
    .dr-left {
        flex: 0 0 264px;
        background: var(--panel-bg);
        border: 1px solid var(--panel-brd);
        border-radius: 8px;
        overflow: hidden;
        position: sticky;
        top: 80px;
    }

    /* Cover wrapper — desktop: panel-filling, mobile: centered float */
    .dr-cover-wrap {
        position: relative;
        display: block;
    }

    .dr-cover {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
    }

    /* Views badge overlaid on cover (mobile only by default) */
    .dr-cover-views {
        display: none;
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,0.62);
        backdrop-filter: blur(8px);
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.9);
        align-items: center;
        gap: 4px;
        white-space: nowrap;
        pointer-events: none;
    }

    .dr-panel-body { padding: 14px 14px 16px; }

    /* Rating button */
    .dr-rate-btn {
        width: 100%;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1.5px solid rgba(245,158,11,0.50);
        background: rgba(245,158,11,0.06);
        border-radius: 8px;
        color: #f59e0b;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        margin-bottom: 14px;
        transition: background 0.2s;
    }
    .dr-rate-btn:hover { background: rgba(245,158,11,0.13); }

    /* Stats */
    .dr-stats {
        display: flex;
        border: 1px solid var(--panel-brd);
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 14px;
    }
    .dr-stat {
        flex: 1;
        padding: 9px 4px;
        text-align: center;
        border-right: 1px solid var(--panel-brd);
    }
    .dr-stat:last-child { border-right: none; }
    .dr-stat-val {
        font-size: 14px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        margin-bottom: 2px;
        white-space: nowrap;
    }
    .dr-stat-lbl {
        font-size: 9.5px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
        color: var(--lbl);
    }
    /* Stat icon: qora PNG → currentColor bilan bo'yaladi (mask) */
    .dr-stat-ic {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        background-color: currentColor;
        -webkit-mask: var(--ic) center / contain no-repeat;
        mask: var(--ic) center / contain no-repeat;
    }

    .dr-div { height: 1px; background: var(--div); margin: 12px 0; }

    /* Status / Type */
    .dr-st-row { display: flex; gap: 22px; }
    .dr-meta-item { display: flex; flex-direction: column; gap: 3px; }
    .dr-meta-lbl {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 700;
        color: var(--lbl);
    }
    .dr-meta-val {
        font-size: 13px;
        font-weight: 700;
        color: var(--acc);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .dr-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--acc);
        display: inline-block;
        flex-shrink: 0;
    }

    /* Author / Artist rows */
    .dr-person-row {
        display: flex;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--div);
        gap: 8px;
    }
    .dr-person-row:last-of-type { border-bottom: none; }
    .dr-person-icon { font-size: 13px; width: 22px; flex-shrink: 0; color: var(--lbl); }
    .dr-person-lbl  { font-size: 11px; color: var(--lbl); font-weight: 600; width: 52px; flex-shrink: 0; }
    .dr-person-val  { font-size: 13px; font-weight: 700; color: var(--val); }

    /* Genre tags */
    .dr-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .dr-tag {
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 600;
        background: var(--tag-bg);
        border: 1px solid var(--tag-brd);
        color: var(--tag-col);
        text-decoration: none;
        transition: background 0.15s;
    }
    .dr-tag:hover { background: var(--acc-light); }

    /* ── RIGHT COLUMN ── */
    .dr-right { flex: 1; min-width: 0; }

    .dr-title {
        font-size: clamp(20px, 2.5vw, 30px);
        font-weight: 900;
        margin: 0 0 10px;
        line-height: 1.2;
        color: var(--val);
    }

    .dr-rank-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        flex-wrap: wrap;
        min-height: 24px;
    }
    .dr-rank-badge {
        background: #f59e0b;
        color: #000;
        font-size: 11px;
        font-weight: 900;
        padding: 3px 10px;
        border-radius: 4px;
        white-space: nowrap;
    }
    .dr-alt {
        font-size: 12px;
        color: var(--lbl);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
    }

    .dr-desc {
        font-size: 14px;
        line-height: 1.78;
        color: var(--val);
        opacity: 0.82;
        margin-bottom: 4px;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    /* Ko'proq ko'rish ichidagi qo'shimcha info */
    .dr-info-section {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--div);
        animation: dr-info-in 0.25s ease;
    }
    @@keyframes dr-info-in {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .dr-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 14px 22px;
    }
    .dr-info-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .dr-info-lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        opacity: 0.5;
    }
    .dr-info-val {
        font-size: 14px;
        font-weight: 700;
        color: var(--val);
    }
    .dr-desc.clamped {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .dr-show-more {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--acc);
        cursor: pointer;
        margin-bottom: 24px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: none;
        background: none;
        padding: 0;
    }

    /* Info card & chapter section shapes */
    .dr-info-card {
        background: #17181e;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 20px 18px 16px;
        margin-bottom: 12px;
    }
    .ch-section {
        background: #17181e;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        padding: 16px;
    }
    .ch-section .ch-hdr { margin-bottom: 12px; }
    .ch-section .ch-srch-wrap { margin-bottom: 12px; }

    /* Action buttons — orqa karta yo'q, tugmalarning o'zi shaklli */
    .dr-actions { display: flex; gap: 10px; margin: 0 0 28px; }

    .dr-btn-bm {
        flex: 1.3;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 8px;
        font-size: 14.5px;
        font-weight: 800;
        cursor: pointer;
        border: none;
        background: var(--acc);
        color: #fff;
        transition: opacity 0.2s;
        white-space: nowrap;
    }
    .dr-btn-bm:hover { opacity: 0.88; }
    .dr-btn-bm.saved {
        background: var(--acc-light);
        color: var(--acc);
        border: 1.5px solid var(--acc-border);
    }

    .dr-btn-ch {
        flex: 1;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: 1.5px solid var(--panel-brd);
        background: var(--panel-bg);
        color: inherit;
        transition: border-color 0.2s, background 0.2s;
        white-space: nowrap;
    }
    .dr-btn-ch:hover { border-color: var(--acc); background: var(--acc-light); color: inherit; }

    /* Chapter header */
    .ch-hdr {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }
    .ch-count { font-size: 1rem; font-weight: 700; }
    .ch-sort {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid var(--panel-brd);
        background: var(--panel-bg);
        cursor: pointer;
        color: inherit;
    }

    /* Search */
    .ch-srch-wrap { position: relative; margin-bottom: 12px; }
    .ch-srch-inp {
        width: 100%;
        height: 46px;
        padding: 0 44px 0 16px;
        border-radius: 10px;
        background: var(--panel-bg);
        border: 1px solid var(--panel-brd);
        color: inherit;
        font-size: 14px;
        outline: none;
        font-family: inherit;
    }
    .ch-srch-ico {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.32;
        pointer-events: none;
        display: flex;
        align-items: center;
        pointer-events: none;
    }

    /* Chapter list */
    .ch-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 560px;
        overflow-y: auto;
        padding: 2px;
    }
    .ch-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 16px;
        border: 1px solid var(--panel-brd);
        border-radius: 10px;
        background: var(--panel-bg);
        text-decoration: none;
        color: inherit;
        transition: background 0.15s, border-color 0.15s;
        position: relative;
    }
    .ch-row:hover { background: var(--ch-hover); border-color: var(--acc-border); }

    /* Locked chapter: nozik gradient highlight chapdan */
    .ch-row.locked {
        background: linear-gradient(90deg,
            rgba(245,158,11,0.08) 0%,
            rgba(245,158,11,0.02) 35%,
            transparent 60%);
    }
    .ch-row.locked:hover {
        background: linear-gradient(90deg,
            rgba(245,158,11,0.14) 0%,
            rgba(245,158,11,0.04) 35%,
            var(--ch-hover) 100%);
    }

    .ch-name { font-weight: 500; font-size: 14px; }
    .ch-sub  { font-size: 12px; opacity: 0.40; margin-left: 8px; }
    .ch-lock-icon {
        width: 14px; height: 16px;
        flex-shrink: 0;
        display: inline-block;
        background-color: #f59e0b;
        -webkit-mask: url('/img/padlock.png') center / contain no-repeat;
        mask: url('/img/padlock.png') center / contain no-repeat;
    }
    /* Qulf ikonkasi (matn ichida) — padlock.png, oltin rang */
    .lock-ic-amber {
        width: 14px; height: 15px;
        flex-shrink: 0;
        display: inline-block;
        vertical-align: -2px;
        margin-right: 3px;
        background-color: #f59e0b;
        -webkit-mask: url('/img/padlock.png') center / contain no-repeat;
        mask: url('/img/padlock.png') center / contain no-repeat;
    }
    .ch-coin {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        background: linear-gradient(135deg, rgba(245,158,11,0.28), rgba(245,158,11,0.14));
        color: #f59e0b;
        padding: 5px 12px;
        border-radius: 999px;
        font-weight: 800;
        margin-left: 10px;
        border: 1px solid rgba(245,158,11,0.35);
    }
    .ch-coin img { width: 17px; height: 17px; }
    .ch-date { font-size: 11px; color: var(--lbl); flex-shrink: 0; }

    /* Rating widget */
    .dr-rating-section {
        margin-top: 40px;
        padding-top: 28px;
        border-top: 1px solid var(--div);
        text-align: center;
    }
    .dr-rating-title   { font-size: 16px; font-weight: 800; margin-bottom: 14px; color: var(--val); }
    /* Image-4 uslubidagi quti */
    .dr-rate-box {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        background: rgba(245,158,11,0.07);
        border: 1px solid rgba(245,158,11,0.28);
        border-radius: 14px;
        padding: 12px 22px;
    }
    .dr-rate-label { font-size: 14px; font-weight: 700; color: #FACC15; white-space: nowrap; }
    .dr-stars-row  { display: inline-flex; gap: 7px; }
    .dr-star {
        width: 25px; height: 25px;
        cursor: pointer;
        border: none;
        padding: 0;
        background-color: rgba(255,255,255,0.26);
        -webkit-mask: url('/img/stat-star.png') center / contain no-repeat;
        mask: url('/img/stat-star.png') center / contain no-repeat;
        transition: transform 0.13s, background-color 0.13s;
    }
    .dr-star.active { background-color: #FACC15; }
    .dr-star:hover { transform: scale(1.18); }
    .dr-rating-thanks  { font-size: 13px; font-weight: 700; color: var(--acc); margin-top: 12px; }

    /* Scroll-to-top */
    .dr-scroll-top {
        position: fixed;
        bottom: 28px;
        right: 28px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--acc);
        color: #fff;
        border: none;
        font-size: 22px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.35);
        z-index: 999;
        transition: opacity 0.2s;
    }
    .dr-scroll-top:hover { opacity: 0.83; }

    @@media (max-width: 768px) {
        /* MudAppBar mobileda 56px, padding-top 64px → 8px bo'shliq.
           Shu bo'shliqni berkitish uchun .dr tepaga ko'tariladi. */
        .dr { margin-top: 0; }

        /* Unwrap .dr-left */
        .dr-left { display: contents; }

        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
        /* TELEFON: reference pixel o'lchamlar asosida           */
        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

        /* ── BLUR ORQA FON ── */
        .dr-bg {
            height: 640px;
            min-height: unset;
            filter: blur(8px) brightness(0.72) saturate(1.4);
            transform: scale(1.06);
            opacity: 1;
        }
        /* Gradient: dr-bg (640px) dan 60px balandroq, solid 78% */
        .dr-bg-grad {
            height: 700px;
            min-height: unset;
            background: linear-gradient(
                to bottom,
                rgba(16,16,20,0.0)  0%,
                rgba(16,16,20,0.10) 22%,
                rgba(16,16,20,0.55) 50%,
                rgba(16,16,20,0.95) 68%,
                #101014             78%
            );
        }

        /* ── KOVER RASM: markazda, blur ustida suzib turadi ── */
        .dr-cover-wrap {
            order: 1;
            align-self: center;
            position: relative;
            z-index: 4;
            margin: 28px auto 14px;
        }
        .dr-cover {
            width: 190px;
            height: 285px;
            aspect-ratio: 2/3;
            border-radius: 10px;
            flex-shrink: 0;
            display: block;
            margin: 0;
            box-shadow:
                0 20px 50px rgba(0,0,0,0.75),
                0 6px 18px rgba(0,0,0,0.55),
                0 0 0 2px rgba(255,255,255,0.12);
        }
        /* Views badge visible on mobile */
        .dr-cover-views {
            display: flex;
        }

        /* Panel body: order 3 — cartning davomi (mobilda yashirin) */
        .dr-panel-body {
            display: none;
        }

        /* Right column: order 2 — ichki cardlar o'z stilida.
           Gorizontal padding YO'Q — yon bo'shliqni faqat .dr-wrap (12px) beradi,
           aks holda kartalar 24px ichkarida qolib, eni tor bo'lib ketadi. */
        .dr-right {
            order: 2;
            padding: 8px 0;
            flex: none;
            width: 100%;
            margin: 0;
            box-sizing: border-box;
            background: transparent;
            border-radius: 0;
            position: relative;
            z-index: 3;
        }

        /* ── SARLAVHA: ref → h1 352×50, text-xl=20px, font-semibold, leading-tight ── */
        .dr-title {
            font-size: 20px;       /* ref: text-xl = 20px */
            font-weight: 600;      /* ref: font-semibold  */
            line-height: 1.25;     /* ref: leading-tight  */
            margin-bottom: 6px;
        }
        /* Sarlavha-tavsif orasidagi bo'sh joy: min-height=0, margin kamaytirish */
        .dr-rank-row {
            min-height: 0;
            margin-bottom: 8px;
        }

        /* ── STATISTIKA: ref → div 352×65, bg-white/5, rounded-lg, p-3=12px, mt-4=16px ── */
        .dr-stats {
            display: flex;
            background: rgba(255,255,255,0.05);  /* ref: bg-white/5 */
            border: none;                          /* chegarasiz      */
            border-radius: 8px;                    /* ref: rounded-lg */
            overflow: hidden;
            margin-top: 16px;                      /* ref: mt-4=16px  */
            margin-bottom: 16px;
        }
        .dr-stat {
            flex: 1;
            padding: 12px 4px;                    /* ref: p-3=12px   */
            border-right: 1px solid var(--panel-brd);
        }
        .dr-stat:last-child { border-right: none; }
        .dr-stat-val { font-size: 15px; font-weight: 900; }
        .dr-stat-lbl { font-size: 9px;  letter-spacing: 0.3px; }

        /* Rate button va uning konteyneri: mobilda yashirin */
        .dr-rate-btn  { display: none; }
        .dr-panel-body { display: none; }

        /* ── AMAL TUGMALARI: ref → container 376×97.6, mt-3=12px ── */
        .dr-actions {
            flex-wrap: wrap;
            gap: 8px;
            margin: 0 0 16px;      /* ch-section bilan oraliq */
        }
        /* Bookmark: ref → 376×44, py-3 px-4, rounded-md */
        .dr-btn-bm {
            flex: 1 1 100%;
            height: 44px;          /* ref: 44px            */
            padding: 12px 16px;    /* ref: py-3=12 px-4=16 */
            border-radius: 8px;    /* ref: rounded-md      */
            font-size: 14px;
            font-weight: 700;
        }
        /* Chapter tugmalar: ref → 184×45.6, font 14px, gap mos */
        .dr-btn-ch {
            flex: 1 1 calc(50% - 4px);
            height: 46px;          /* ref: ~45.6px         */
            font-size: 14px;       /* ref: 14px            */
            border-radius: 8px;    /* ref: rounded-md      */
            gap: 6px;
        }
        /* Eye icon ichida: ref → svg.w-4.h-4 = 16×16 */
        .dr-btn-ch svg { width: 16px; height: 16px; flex-shrink: 0; }

        /* Chapter list — Asura uslubi: ~10 bob ko'rinadi, qolgani ichida scroll bo'ladi */
        .ch-list { max-height: 600px; }
