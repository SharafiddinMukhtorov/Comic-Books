            }
        </div>
    </div>

    <!-- Scroll to top -->
    <button class="dr-scroll-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Yuqoriga">↑</button>
</div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    ComicDto?        _comic;
    List<ChapterDto> _chapters      = new();
    bool   _loading         = true;
    bool   _desc            = false;   // standart: eski (1-bob) tepada
    bool   _showMore        = false;
    bool   _showRating      = true;   // doim ko'rsatamiz (mobilda rate tugmasi yashirin edi)
    string _chapSearch      = "";
    int    _hoverStar       = 0;
    int    _userStars       = 0;      // foydalanuvchining bahosi (1-5; 0 = baholanmagan)

    // Comments
    List<ChapterCommentDto> _comicComments = new();
    int _commentsShown = 10;   // boshida 10 ta izoh, "Ko'proq ko'rish" bilan ko'payadi
    string _newComicComment = "";
    bool   _postingComicComment = false;
    Guid   _currentUserId = Guid.Empty;
    bool   _isAdmin       = false;

    bool IsBookmarked => _comic != null && BookmarkSvc.IsBookmarked(_comic.Id);
    Guid FirstId => _chapters.OrderBy(c => c.ChapterNumber).FirstOrDefault()?.Id ?? Guid.Empty;
    Guid LastId  => _chapters.OrderByDescending(c => c.ChapterNumber).FirstOrDefault()?.Id ?? Guid.Empty;

    string CoverUrl() => !string.IsNullOrEmpty(_comic?.CoverImageUrl)
        ? _comic.CoverImageUrl
        : $"https://picsum.photos/seed/{_comic?.Slug}/300/420";

    string BgUrl() => !string.IsNullOrEmpty(_comic?.BannerImageUrl) ? _comic.BannerImageUrl
                    : !string.IsNullOrEmpty(_comic?.CoverImageUrl)  ? _comic.CoverImageUrl
                    : $"https://picsum.photos/seed/{_comic?.Slug}bg/1400/600";

    string Fmt(int v) => v >= 1_000_000 ? $"{v/1_000_000.0:F1}M"
                       : v >= 1_000     ? $"{v/1_000.0:F1}K"
                       : v.ToString();

    string FmtDate(DateTime? d)
    {
        if (d is null) return "";
        var diff = DateTime.UtcNow - d.Value;
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m oldin";
        if (diff.TotalHours  < 24) return $"{(int)diff.TotalHours}s oldin";
        if (diff.TotalDays   < 7)  return $"{(int)diff.TotalDays} kun oldin";
        if (diff.TotalDays   < 30) return $"{(int)(diff.TotalDays/7)} hafta oldin";
        return d.Value.ToString("MMM d, yyyy");
    }

    List<ChapterDto> Filtered()
    {
        var list = _desc
            ? _chapters.OrderByDescending(c => c.ChapterNumber).ToList()
            : _chapters.OrderBy(c => c.ChapterNumber).ToList();
        if (!string.IsNullOrWhiteSpace(_chapSearch))
            list = list.Where(c => c.ChapterNumber.ToString().Contains(_chapSearch)
                               || (c.Title ?? "").Contains(_chapSearch, StringComparison.OrdinalIgnoreCase))
                       .ToList();
        return list;
    }

    protected override async Task OnInitializedAsync()
    {
        var st = await AuthState.GetAuthenticationStateAsync();
        if (st.User.Identity?.IsAuthenticated == true
            && Guid.TryParse(st.User.FindFirst("app_user_id")?.Value, out var uid))
        {
            _currentUserId = uid;
            _isAdmin = st.User.FindFirst("app_is_admin")?.Value == "true";
        }

        _comic = await Mediator.Send(new GetComicBySlugQuery(Slug));
        if (_comic != null)
        {
            _chapters = await Mediator.Send(new GetChaptersByComicQuery(_comic.Id));
            _ = LoadCommentsAsync();
        }
        _loading = false;
    }

    async Task LoadCommentsAsync()
    {
        if (_comic is null) return;
        try
        {
            _comicComments = await Mediator.Send(new GetComicCommentsQuery(_comic.Id));
            await InvokeAsync(StateHasChanged);
        }
        catch { _comicComments = new(); }
    }

    async Task PostComicComment()
    {
        if (_comic is null || _currentUserId == Guid.Empty
            || string.IsNullOrWhiteSpace(_newComicComment)
            || _newComicComment.Trim().Length < 2) return;
        _postingComicComment = true;
        try
        {
            await Mediator.Send(new AddComicCommentCommand(_comic.Id, _currentUserId, _newComicComment.Trim()));
            _newComicComment = "";
            await LoadCommentsAsync();
            Snackbar.Add("Izoh qo'shildi", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"❌ {ex.Message}", Severity.Error); }
        _postingComicComment = false;
    }

    async Task DeleteComicComment(Guid id)
    {
        var ok = await Mediator.Send(new DeleteCommentCommand(id, _currentUserId, _isAdmin));
        if (ok)
        {
            _comicComments.RemoveAll(c => c.Id == id);
            await InvokeAsync(StateHasChanged);
        }
    }

    static string FmtCommentTime(DateTime d)
    {
        var diff = DateTime.UtcNow - d;
        if (diff.TotalMinutes < 1)  return "hozirgina";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} daq oldin";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} soat oldin";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays} kun oldin";
        if (diff.TotalDays    < 30) return $"{(int)(diff.TotalDays / 7)} hafta oldin";
        return d.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _comic is null) return;

        await BookmarkSvc.EnsureLoadedAsync();

        var sessionId = await SessionSvc.GetSessionIdAsync();
        var counted   = await Mediator.Send(new TrackComicViewCommand(sessionId, _comic.Id));
        if (counted) _comic.ViewCount++;

        // Oldin baholaganmi? — eslab qolish (localStorage)
        if (_currentUserId != Guid.Empty)
        {
            try
            {
                var saved = await JS.InvokeAsync<string>("localStorage.getItem", $"md_rating_{_currentUserId}_{_comic.Id}");
                if (int.TryParse(saved, out var s) && s >= 1 && s <= 5)
                {
                    _userStars = s;
                }
            }
            catch { }
        }

        await InvokeAsync(StateHasChanged);
    }

    async Task ToggleBookmark()
    {
        if (_comic is null) return;
        await BookmarkSvc.ToggleAsync(_comic.Id);
        if (BookmarkSvc.IsBookmarked(_comic.Id))
            _comic.BookmarkCount++;
        else if (_comic.BookmarkCount > 0)
            _comic.BookmarkCount--;
        await InvokeAsync(StateHasChanged);
    }

    async Task SetRating(int star)
    {
        if (_comic is null) return;
        if (_currentUserId == Guid.Empty) { Nav.NavigateTo("/login"); return; }  // baholash uchun ro'yxatdan o'tish

        // Bir xil yulduzni qayta bossa — bahoni bekor qiladi (qaytarib oladi)
        if (_userStars == star)
        {
            _userStars = 0;
            try { await JS.InvokeVoidAsync("localStorage.removeItem", $"md_rating_{_currentUserId}_{_comic.Id}"); } catch { }
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Boshqa yulduz — bahoni o'zgartiradi
        _userStars = star;
        var newAvg = await Mediator.Send(new RateComicCommand(_comic.Id, star * 2));  // 1 yulduz = 2 ball
        _comic.AverageRating = newAvg;
        try { await JS.InvokeVoidAsync("localStorage.setItem", $"md_rating_{_currentUserId}_{_comic.Id}", star.ToString()); } catch { }
        await InvokeAsync(StateHasChanged);
    }
}
