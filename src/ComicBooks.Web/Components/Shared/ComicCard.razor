@inject NavigationManager Nav
@inject BookmarkService BookmarkSvc

<div class="cc-card @(_hover ? "hover" : "")"
     @onclick="@Go"
     @onmouseover="@(() => _hover=true)"
     @onmouseout="@(() => _hover=false)">

    <!-- Cover image area -->
    <div class="cc-cover">

        <img src="@CoverUrl()"
             alt="@Comic.Title"
             loading="lazy"
             class="cc-img"
             onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(Comic.Slug)/300/420'" />

        <!-- Bookmark top-right -->
        <div @onclick:stopPropagation="true" @onclick="@Bookmark" class="cc-bm">
            <MudIcon Icon="@(BookmarkSvc.IsBookmarked(Comic.Id) ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                     Style="@(BookmarkSvc.IsBookmarked(Comic.Id) ? "color:#60a5fa;" : "color:rgba(255,255,255,0.75);")"
                     Size="Size.Small" />
        </div>

        <!-- Type (chap-past) + Status (o'ng-past) yorliqlari -->
        <div class="cc-badges">
            <span class="cc-type">@TypeLabel()</span>
            <span class="cc-status" style="@StatusBg()">@StatusLabel()</span>
        </div>
    </div>

    <!-- Info below cover -->
    <div class="cc-info">
        <div class="cc-title">@Comic.Title</div>
        @if (Comic.LatestChapterNumber.HasValue)
        {
            <div class="cc-chap">Bob @((int)Comic.LatestChapterNumber.Value)</div>
        }
    </div>
</div>

<style>
    .cc-card {
        cursor: pointer;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 4px 14px rgba(0,0,0,0.14);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    /* Hover: ko'tarilish + orqadan nurga o'xshagan ko'k aura (glow) */
    .cc-card.hover {
        transform: translateY(-6px);
        z-index: 5;
        box-shadow:
            0 0 0 1.5px rgba(96,165,250,0.55),
            0 10px 26px rgba(59,130,246,0.42),
            0 0 26px rgba(59,130,246,0.45),
            0 0 56px rgba(96,165,250,0.32);
    }

    .cc-cover {
        position: relative;
        aspect-ratio: 2/3;
        background: #1a1c28;
        overflow: hidden;
    }
    .cc-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
    }
    /* Hover: rasm biroz zoom */
    .cc-card.hover .cc-img { transform: scale(1.07); }

    .cc-bm {
        position: absolute;
        top: 8px; right: 8px;
        z-index: 3;
        background: rgba(0,0,0,0.55);
        backdrop-filter: blur(4px);
        border-radius: 50%;
        width: 28px; height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    /* Type + Status badgelar (rasm pastida) */
    .cc-badges {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        z-index: 3;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 5px;
        padding: 16px 6px 6px;
        background: linear-gradient(transparent, rgba(0,0,0,0.82));
    }
    .cc-type, .cc-status {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.1px;
        padding: 2.5px 6px;
        border-radius: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cc-type {
        color: #fff;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.28);
        backdrop-filter: blur(4px);
        flex-shrink: 0;          /* tur yorlig'i qisqarmaydi */
    }
    .cc-status {
        min-width: 0;            /* kerak bo'lsa status qisqaradi, kartadan toshmaydi */
    }

    .cc-info { padding: 9px 10px 11px; }
    .cc-title {
        font-size: 13px;
        font-weight: 700;
        line-height: 1.4;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        min-height: 34px;
    }
    .cc-chap {
        font-size: 11px;
        font-weight: 500;
        color: #4C7DFF;
        margin-top: 3px;
    }
</style>

@code {
    [Parameter, EditorRequired] public ComicDto Comic { get; set; } = default!;
    bool _hover;

    void Go() => Nav.NavigateTo($"/comic/{Comic.Slug}");
    async Task Bookmark() => await BookmarkSvc.ToggleAsync(Comic.Id);

    string CoverUrl() => !string.IsNullOrEmpty(Comic.CoverImageUrl)
        ? Comic.CoverImageUrl
        : $"https://picsum.photos/seed/{Comic.Slug}/300/420";

    string TypeLabel() => Comic.Type switch
    {
        ComicType.Manhwa => "Manhva",
        ComicType.Manga  => "Manga",
        ComicType.Manhua => "Manhua",
        _                => Comic.Type.ToString()
    };

    string StatusLabel() => Comic.Status switch
    {
        ComicStatus.Ongoing   => "Davom etmoqda",
        ComicStatus.Completed => "Tugallangan",
        ComicStatus.Hiatus    => "To'xtatilgan",
        _                     => Comic.Status.ToString()
    };

    string StatusBg() => Comic.Status switch
    {
        ComicStatus.Ongoing   => "background:#059669;color:#fff;",
        ComicStatus.Completed => "background:#2563eb;color:#fff;",
        ComicStatus.Hiatus    => "background:#d97706;color:#fff;",
        _                     => "background:#374151;color:#fff;"
    };
}
