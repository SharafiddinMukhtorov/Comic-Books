@inject NavigationManager Nav
@inject BookmarkService BookmarkSvc

<div @onclick="@Go"
     @onmouseover="@(() => _hover=true)"
     @onmouseout="@(() => _hover=false)"
     style="cursor:pointer;border-radius:10px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s;position:relative;@(_hover?"transform:translateY(-5px);box-shadow:0 16px 40px rgba(0,0,0,0.5);":"")">

    <!-- Cover image area -->
    <div style="position:relative;aspect-ratio:2/3;background:#12121e;overflow:hidden;border-radius:10px;">

        <img src="@CoverUrl()"
             alt="@Comic.Title"
             loading="lazy"
             style="width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.3s;@(_hover?"transform:scale(1.04);":"")"
             onerror="this.onerror=null;this.src='https://picsum.photos/seed/@(Comic.Slug)/300/420'" />

        <!-- Rating badge top-left -->
        <div style="position:absolute;top:8px;left:8px;z-index:3;
                    background:rgba(0,0,0,0.70);backdrop-filter:blur(4px);
                    border-radius:5px;padding:3px 8px;
                    display:flex;align-items:center;gap:3px;">
            <span style="color:#f59e0b;font-size:11px;line-height:1;">★</span>
            <span style="font-size:11px;font-weight:800;color:#fff;line-height:1;">@Comic.AverageRating.ToString("F1")</span>
        </div>

        <!-- Bookmark top-right -->
        <div @onclick:stopPropagation="true" @onclick="@Bookmark"
             style="position:absolute;top:8px;right:8px;z-index:3;
                    background:rgba(0,0,0,0.55);backdrop-filter:blur(4px);
                    border-radius:50%;width:28px;height:28px;
                    display:flex;align-items:center;justify-content:center;cursor:pointer;">
            <MudIcon Icon="@(BookmarkSvc.IsBookmarked(Comic.Id) ? Icons.Material.Filled.Bookmark : Icons.Material.Outlined.BookmarkBorder)"
                     Style="@(BookmarkSvc.IsBookmarked(Comic.Id) ? "color:#419fd9;" : "color:rgba(255,255,255,0.75);")"
                     Size="Size.Small" />
        </div>

        <!-- Latest chapter badge bottom -->
        @if (Comic.LatestChapterNumber.HasValue)
        {
            <div style="position:absolute;bottom:0;left:0;right:0;z-index:2;
                        background:linear-gradient(transparent,rgba(0,0,0,0.88));
                        padding:18px 8px 7px;">
                <span style="font-size:11px;font-weight:700;color:#92d4fc;">
                    Chapter @((int)Comic.LatestChapterNumber.Value)
                </span>
            </div>
        }

        <!-- Hover overlay -->
        @if (_hover)
        {
            <div style="position:absolute;inset:0;z-index:2;
                        background:rgba(27,19,190,0.18);
                        display:flex;align-items:center;justify-content:center;">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow"
                         Style="font-size:42px;color:rgba(255,255,255,0.92);" />
            </div>
        }
    </div>

    <!-- Info below cover -->
    <div style="padding:8px 2px 5px;">
        <div style="font-size:12.5px;font-weight:700;line-height:1.4;
                    overflow:hidden;display:-webkit-box;
                    -webkit-line-clamp:2;-webkit-box-orient:vertical;
                    min-height:34px;margin-bottom:3px;">
            @Comic.Title
        </div>
        <!-- Star ratings + status badge -->
        <div style="display:flex;align-items:center;justify-content:space-between;gap:4px;">
            <div style="display:flex;align-items:center;gap:1px;">
                @for (int s = 1; s <= 5; s++)
                {
                    <span style="font-size:10.5px;color:@(s <= (int)Math.Round(Comic.AverageRating/2) ? "#f59e0b" : "rgba(128,128,128,0.35)");">★</span>
                }
                <span style="font-size:10.5px;color:#f59e0b;font-weight:700;margin-left:3px;">@Comic.AverageRating.ToString("F1")</span>
            </div>
            <span style="@StatusBg();font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px;letter-spacing:0.2px;text-transform:uppercase;flex-shrink:0;">
                @Comic.Status
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ComicDto Comic { get; set; } = default!;
    bool _hover;

    void Go() => Nav.NavigateTo($"/comic/{Comic.Slug}");
    async Task Bookmark() => await BookmarkSvc.ToggleAsync(Comic.Id);

    string CoverUrl() => !string.IsNullOrEmpty(Comic.CoverImageUrl)
        ? Comic.CoverImageUrl
        : $"https://picsum.photos/seed/{Comic.Slug}/300/420";

    string StatusBg() => Comic.Status switch
    {
        ComicStatus.Ongoing   => "background:#059669;color:#fff;",
        ComicStatus.Completed => "background:#419fd9;color:#fff;",
        ComicStatus.Hiatus    => "background:#d97706;color:#fff;",
        _                     => "background:#374151;color:#fff;"
    };
}
