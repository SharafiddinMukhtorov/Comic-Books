@* Custom video player — katta markaziy play tugmasi, avtomatik yashiruvchi boshqaruv paneli,
   progress/buffered chiziq, yuklanish spinneri va ICHKI sifat menyusi (Avto/480p/720p/1080p).
   Sifat almashtirish haqiqiy ishlaydi: joriy pozitsiya va ijro holati saqlanib, manba almashtiriladi. *@
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_containerId" class="vp-container" data-vp="root">
    <video playsinline></video>

    <div class="vp-spinner" data-vp="spinner">
        <svg viewBox="0 0 50 50"><circle cx="25" cy="25" r="20" fill="none" stroke-width="4"></circle></svg>
    </div>

    <button type="button" class="vp-center-play" data-vp="centerplay" aria-label="Ijro etish">
        <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </button>

    <div class="vp-controls" data-vp="controls">
        <div class="vp-progress-wrap" data-vp="progresswrap">
            <div class="vp-progress-buffered" data-vp="buffered"></div>
            <div class="vp-progress-played" data-vp="played"><span class="vp-progress-thumb"></span></div>
            <input type="range" class="vp-seek" data-vp="seek" min="0" max="1000" value="0" />
        </div>
        <div class="vp-controls-row">
            <button type="button" class="vp-btn vp-skip" data-vp="back5" aria-label="5 soniya orqaga">
                <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                <span class="vp-skip-n">5</span>
            </button>
            <button type="button" class="vp-btn" data-vp="play" aria-label="Play/Pause">
                <svg class="vp-ic-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="vp-ic-pause" viewBox="0 0 24 24" style="display:none;"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
            </button>
            <button type="button" class="vp-btn vp-skip vp-skip-fwd" data-vp="fwd5" aria-label="5 soniya oldinga">
                <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                <span class="vp-skip-n">5</span>
            </button>
            <span class="vp-time" data-vp="time">0:00 / 0:00</span>
            <div class="vp-spacer"></div>

            @if (_qualities.Count > 1)
            {
                <div class="vp-quality-wrap">
                    @if (_qualityMenuOpen)
                    {
                        <div class="vp-quality-backdrop" @onclick="@(() => _qualityMenuOpen = false)"></div>
                        <div class="vp-quality-menu">
                            @foreach (var q in _qualities)
                            {
                                var qq = q;
                                <div class="vp-quality-item @(_activeQuality == qq.Label ? "active" : "")" @onclick="@(() => SwitchQuality(qq))">
                                    @qq.Label
                                    @if (_activeQuality == qq.Label) { <span class="vp-quality-check">✓</span> }
                                </div>
                            }
                        </div>
                    }
                    <button type="button" class="vp-btn" @onclick="@(() => _qualityMenuOpen = !_qualityMenuOpen)" aria-label="Sifat">
                        <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                    </button>
                </div>
            }

            <button type="button" class="vp-btn vp-volume-btn" data-vp="volume-btn" aria-label="Ovoz">
                <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05A4.5 4.5 0 0 0 16.5 12z"/></svg>
            </button>
            <input type="range" class="vp-volume" data-vp="volume" min="0" max="100" value="100" />
            <button type="button" class="vp-btn" data-vp="fullscreen" aria-label="To'liq ekran">
                <svg class="vp-ic-fs-off" viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
                <svg class="vp-ic-fs-on" viewBox="0 0 24 24" style="display:none;"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public string? Url480p { get; set; }
    [Parameter] public string? Url720p { get; set; }
    [Parameter] public string? Url1080p { get; set; }
    [Parameter] public bool AutoPlay { get; set; }

    record Quality(string Label, string Url);

    readonly string _containerId = "vp-" + Guid.NewGuid().ToString("N");
    string? _initedForSrc;
    bool _qualityMenuOpen = false;
    string _activeQuality = "Avto";

    List<Quality> _qualities = new();

    protected override void OnParametersSet()
    {
        _qualities = new List<Quality> { new("Avto", Src) };
        if (!string.IsNullOrWhiteSpace(Url1080p)) _qualities.Add(new("1080p", Url1080p));
        if (!string.IsNullOrWhiteSpace(Url720p))  _qualities.Add(new("720p", Url720p));
        if (!string.IsNullOrWhiteSpace(Url480p))  _qualities.Add(new("480p", Url480p));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("videoPlayer.init", _containerId, Src);
            _initedForSrc = Src;
            _activeQuality = "Avto";
            if (AutoPlay) await JS.InvokeVoidAsync("videoPlayer.play", _containerId);
        }
        else if (_initedForSrc != Src)
        {
            // Yangi video (masalan boshqa qism) — sifat holatini "Avto"ga qaytarib, to'liq yuklaymiz
            await JS.InvokeVoidAsync("videoPlayer.setSrc", _containerId, Src);
            _initedForSrc = Src;
            _activeQuality = "Avto";
            if (AutoPlay) await JS.InvokeVoidAsync("videoPlayer.play", _containerId);
        }
    }

    async Task SwitchQuality(Quality q)
    {
        _activeQuality = q.Label;
        _qualityMenuOpen = false;
        await JS.InvokeVoidAsync("videoPlayer.switchQuality", _containerId, q.Url);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("videoPlayer.destroy", _containerId); } catch { }
    }
}
